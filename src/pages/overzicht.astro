---
/**
 * Mijn overzicht: combineert gekozen situaties met de gekozen gemeente.
 * Alles wordt statisch gerenderd; JavaScript toont alleen wat bij de keuze past. De blokken van de gekozen gemeente
 * worden los opgehaald (src/lib/gemeente-blokken.ts), anders zou deze pagina alle 342 gemeenten bevatten.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Contact from '../components/Contact.astro';
import GemeenteKeuze from '../components/GemeenteKeuze.astro';
import SituatieKeuze from '../components/SituatieKeuze.astro';
import KnelpuntKeuze from '../components/KnelpuntKeuze.astro';
import LeeftijdKeuze from '../components/LeeftijdKeuze.astro';
import BriefKaart from '../components/BriefKaart.astro';
import SpoedNummers from '../components/SpoedNummers.astro';
import TherapieKaart from '../components/TherapieKaart.astro';
import { getCollection } from 'astro:content';
import { routeLabel, beginBij, koppelThemas } from '../lib/routes';
import { rangVan, therapieVolgorde, VORMEN_LIJST_MAX, hulpsoortenVoor } from '../lib/therapie';
import HulpsoortKaart from '../components/HulpsoortKaart.astro';
import Sources from '../components/Sources.astro';
import ToegangLegenda from '../components/ToegangLegenda.astro';
import { afbreken } from '../lib/afbreken';
import { genoemdIn } from '../lib/genoemd';
import OrgRegel from '../components/OrgRegel.astro';
import type { ComponentProps } from 'astro/types';
import StapInhoud from '../components/StapInhoud.astro';
import Verdieping from '../components/Verdieping.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
type Knelpunt = (typeof knelpunten)[number];
/** Een stap is tekst, of tekst met vervolgstappen (A, B) die er direct onder horen, zoals de ingebrekestelling na "wacht u op een besluit". */
const hoofdStappen = (k: Knelpunt) => k.data.stappen.map((s) => (typeof s === 'string' ? s : s.stap));
const vervolg = (k: Knelpunt, i: number) => { const s = k.data.stappen[i]; return typeof s === 'string' ? [] : s.daarna; };
/** Alle stappen in leesvolgorde, vervolgstappen meegeteld: "de eerste stap die … noemt" telt ook een vervolgstap. */
const alleStappen = (k: Knelpunt) => k.data.stappen.flatMap((s) => (typeof s === 'string' ? [s] : [s.stap, ...s.daarna]));
/** Per stap de voorbeeldbrief die erbij hoort (alleen brieven van dit knelpunt, elke brief één keer): een link direct achter de stap. */
const STAP_BRIEF: [RegExp, string][] = [
  [/ingebrekestelling/i, 'ingebrekestelling'],
  [/brief waarin u bezwaar maakt/i, 'bezwaar-beschikking'],
  [/klacht in bij de aanbieder/i, 'klacht-aanbieder'],
  [/(dien|dient).{0,40}klacht/i, 'klacht-toegangsteam'],
  [/overdracht/i, 'verhuizing-overdracht'],
  [/één overleg/i, 'gezamenlijk-overleg'],
  [/nieuw gesprek en een nieuw besluit/i, 'verzoek-meer-hulp'],
];
/** Korte naam in de link, zodat twee brieflinks bij elkaar niet hetzelfde heten. */
const BRIEF_LABEL: Record<string, string> = { ingebrekestelling: 'ingebrekestelling', 'bezwaar-beschikking': 'bezwaar', 'klacht-toegangsteam': 'klacht', 'klacht-aanbieder': 'klacht', 'verhuizing-overdracht': 'overdracht', 'gezamenlijk-overleg': 'gezamenlijk overleg', 'verzoek-meer-hulp': 'meer of andere hulp' };
/**
 * Wat er bij elke stap hoort (zie StapInhoud.astro):
 * - genoemde landelijke organisaties: nummer en website onder de stap die ze als eerste noemt, niet in de zin (persona-tests ronde 21);
 * - de voorbeeldbrief;
 * - de cliëntondersteuner van de gemeente onder de eerste stap die hem noemt (niet bij een landelijke vraag);
 * - de aanbieders (Beschikbaarheidswijzer of gemeentepagina) onder de eerste stap over een andere aanbieder;
 * - het wijkteam onder de eerste stap die het noemt, als het niet bovenaan staat (wijkteamBovenaan: false);
 * - hoe het in de gemeente gaat onder stap 1 (standInGemeente);
 * - de rekenhulp onder de stap over bezwaar (afgewezen) of de ingebrekestelling (wachten);
 * - bij "Vindt u de stap spannend?" de tips over hulp vragen;
 * - bij de verhuizing: de plek van de stap in de tijdlijn en de nieuwe gemeente (zie de verdieping hieronder).
 */
/** Verhuizing: welke stap wanneer hoort. De kop ("Nu", "Vóór de verhuizing" …) komt pas als de ouder een datum invult. */
const VERHUIS_MOMENT: [string, 'nu' | 'voor' | 'na' | 'pleeg'][] = [['Meld de verhuizing', 'nu'], ['Vraag het huidige besluit', 'voor'], ['Neem vóór de verhuizing al contact op', 'na'], ['Woont uw kind in een pleeggezin', 'pleeg']];
const verhuisMoment = (x: string) => VERHUIS_MOMENT.find(([begin]) => x.startsWith(begin))?.[1];
/** "De hulp stopt": per stap de reden waar die bij hoort (verdieping "Waarom stopt de hulp?"). Stappen zonder reden gelden altijd. */
const HULP_STOPT_REDEN: { id: string; begin: string; label: string }[] = [
  { id: 'aanbieder', begin: 'Stopt de aanbieder', label: 'De aanbieder stopt' },
  { id: 'klaar', begin: 'Vindt de aanbieder', label: 'De aanbieder vindt de hulp klaar' },
  { id: 'gemeente', begin: 'Heeft de gemeente besloten', label: 'De gemeente stopt de hulp' },
  { id: 'besluit', begin: 'Loopt het besluit af', label: 'Het besluit loopt af' },
  { id: 'achttien', begin: 'Wordt uw kind 18', label: 'Mijn kind wordt 18' },
];
const hulpStoptReden = (x: string) => HULP_STOPT_REDEN.find((r) => x.startsWith(r.begin))?.id;
const stapPropsPer = new Map<string, (st: string) => ComponentProps<typeof StapInhoud>>();
const stapProps = (k: Knelpunt, st: string) => {
  if (!stapPropsPer.has(k.id)) {
    const alle = alleStappen(k);
    const gehad = new Set<string>();
    const orgs = new Map(alle.map((x) => [x, genoemdIn(x, organisaties, gehad)]));
    const gebruikt = new Set<string>();
    const brief = new Map(alle.map((x) => {
      const hit = STAP_BRIEF.find(([re, id]) => re.test(x) && k.data.brieven.includes(id) && !gebruikt.has(id));
      if (hit) gebruikt.add(hit[1]);
      return [x, hit ? { id: hit[1], label: BRIEF_LABEL[hit[1]] } : undefined];
    }));
    const metGemeente = !k.data.zonderGemeente;
    const co = metGemeente ? alle.find((x) => x.includes('cliëntondersteuner')) : undefined;
    const aanb = metGemeente && k.data.gemeenteOnderdelen.includes('aanbieders') ? alle.find((x) => x.includes('andere aanbieder')) : undefined;
    const wt = metGemeente && !k.data.wijkteamBovenaan ? alle.find((x) => x.includes('wijkteam')) : undefined;
    stapPropsPer.set(k.id, (x: string) => ({
      tekst: x,
      orgs: orgs.get(x) ?? [],
      brief: brief.get(x),
      co: x === co,
      aanbieders: x === aanb,
      wijkteam: x === wt,
      stand: metGemeente && x === alle[0] ? k.data.standInGemeente : undefined,
      termijn: k.id === 'afgewezen' && x.startsWith('Stuur binnen zes weken') ? 'bezwaar'
        : k.id === 'wachten' && x.startsWith('Zijn de acht weken') ? 'besluit' : undefined,
      tips: k.id === 'beginnen' && x.startsWith('Vindt u de stap spannend'),
      moment: k.id === 'verhuizing' ? verhuisMoment(x) : undefined,
      nieuw: k.id === 'verhuizing' && verhuisMoment(x) === 'na',
      reden: k.id === 'hulp-stopt' ? hulpStoptReden(x) : undefined,
    }));
  }
  return stapPropsPer.get(k.id)!(st);
};
const situaties = (await getCollection('situaties')).sort((a, b) => a.data.volgorde - b.data.volgorde);
const hulpsoorten = (await getCollection('hulpsoorten')).sort((a, b) => a.data.volgorde - b.data.volgorde);
const organisaties = (await getCollection('organisaties')).sort((a, b) => a.data.naam.localeCompare(b.data.naam));
const gemeenten = (await getCollection('gemeenten')).sort((a, b) => a.data.naam.localeCompare(b.data.naam));
const therapie = (await getCollection('therapievormen')).sort((a, b) => a.data.naam.localeCompare(b.data.naam));
// Hulpsoorten met veel vormen (Behandeling) linken naar de therapievormen hieronder, net als op de situatiepagina.
const veelVormen = (id: string) => therapie.filter((t) => t.data.hulpsoorten.includes(id)).length > VORMEN_LIJST_MAX;
/** Per therapievorm de plek in de volgorde van elke situatie die er een heeft: "situatie:plek". Controleert ook de volgorde zelf. */
situaties.forEach((s) => therapieVolgorde(s, therapie));
const tipRang = (id: string) => situaties.map((s) => { const r = rangVan(s, id); return r === null ? '' : `${s.id}:${r}`; }).filter(Boolean).join(' ');
const knelpunten = (await getCollection('knelpunten')).sort((a, b) => a.data.volgorde - b.data.volgorde);
// Veranderen de stappen van de verhuizing, dan moet de tijdlijn mee; anders valt de verdieping stil zonder dat iemand het ziet.
const verhuisStappen = alleStappen(knelpunten.find((k) => k.id === 'verhuizing')!);
VERHUIS_MOMENT.forEach(([begin]) => { if (!verhuisStappen.some((x) => x.startsWith(begin))) throw new Error(`verhuizing.md: geen stap begint met "${begin}" (zie VERHUIS_MOMENT in overzicht.astro)`); });
const hulpStoptStappen = hoofdStappen(knelpunten.find((k) => k.id === 'hulp-stopt')!);
HULP_STOPT_REDEN.forEach((r) => { if (!hulpStoptStappen.some((x) => x.startsWith(r.begin))) throw new Error(`hulp-stopt.md: geen stap begint met "${r.begin}" (zie HULP_STOPT_REDEN in overzicht.astro)`); });
const brieven = (await getCollection('brieven'));
const knelData = Object.fromEntries(knelpunten.map((k) => [k.id, { onderdelen: k.data.gemeenteOnderdelen, landelijk: k.data.landelijk, zonderGemeente: k.data.zonderGemeente, wijkteamBovenaan: k.data.wijkteamBovenaan }]));
const landelijk = (await getCollection('landelijk')).sort((a, b) => a.data.volgorde - b.data.volgorde);
/** Compacte data voor de browser: per situatie de koppelsleutels. */
const sitData = Object.fromEntries(situaties.map((s) => [s.id, { themas: koppelThemas(s.data.themas), hulpsoorten: hulpsoortenVoor(s, therapie), routes: s.data.routes.map((r) => r.type), landelijk: s.data.landelijk, licht: s.data.lichteStart, jgz: s.data.jgzVoorop, inklap: s.data.lichteStart || s.data.aanvraagIngeklapt, rang: !!s.data.therapievormen, gelijk: !!s.data.routes[0].beginBij }]));
const j = (a: string[]) => a.join(' ');
/** Namen voor de samenvatting van de keuzes. */
const namen = { s: Object.fromEntries(situaties.map((x) => [x.id, x.data.titel])), k: Object.fromEntries(knelpunten.map((x) => [x.id, x.data.titel])), g: Object.fromEntries(gemeenten.map((x) => [x.id, x.data.naam])), l: { '0-4': 'jonger dan 4', '4-12': '4 tot 12 jaar', '12-18': '12 tot 18 jaar', '18-99': '18 of ouder' } as Record<string, string> };
---
<Base title="Mijn overzicht" noindex>
  <div class="page-head">
    <span class="eyebrow">Op maat</span>
    <h1>Mijn overzicht</h1>
    <p class="lead" data-intro>Kies uw gemeente en wat er speelt. U ziet dan alleen wat voor u van toepassing is.</p>
  </div>

  <details class="section regelen keuzes" id="top" data-keuzes>
    <summary><strong>Uw keuzes</strong> <span class="meta" data-keuzes-samenvatting>nog niets gekozen</span> <span class="keuzes-actie">aanpassen</span></summary>
    <div class="wegwijzer light"><GemeenteKeuze /><KnelpuntKeuze /><LeeftijdKeuze /><SituatieKeuze mode="inline" /></div>
    <p class="empty" data-leeg style="margin:1rem 0 0">Kies hierboven een situatie, of waar u staat met de gemeente.</p>
  </details>
  <!-- Meteen (niet pas na het laden van de scripts): open of dicht, en de samenvatting. Anders klapte het blok zichtbaar dicht en versprong de pagina. -->
  <script is:inline define:vars={{ namen }}>
    (() => {
      const p = new URLSearchParams(location.search);
      const v = (k, key) => p.get(k) ?? localStorage.getItem(key) ?? '';
      const s = v('s', 'jr.situaties').split(',').filter(Boolean), k = v('k', 'jr.knelpunt'), g = v('gemeente', 'jr.gemeente'), l = v('l', 'jr.leeftijd');
      const d = document.querySelector('[data-keuzes]');
      if (!(s.length || k || g)) { d.open = true; return; }
      document.querySelectorAll('[data-intro]').forEach((e) => (e.hidden = true));
      // Tot de inhoud getekend is de voettekst verbergen: anders staat die even in beeld en schuift dan weg.
      document.documentElement.classList.add('jr-laden');
      setTimeout(() => document.documentElement.classList.remove('jr-laden'), 3000);
      const delen = [namen.g[g], namen.k[k], ...s.map((id) => namen.s[id]), namen.l[l]].filter(Boolean);
      if (delen.length) d.querySelector('[data-keuzes-samenvatting]').textContent = delen.join(' · ');
    })();
  </script>

  <button type="button" class="keuzes-knop" data-keuzes-aanpassen data-keuzes-knop hidden>Keuzes aanpassen</button>
  <div data-inhoud hidden class="page-with-side">
   <aside class="side">
    <nav aria-label="Inhoud" data-zijnav>
      <div class="side-keuzes">
        <strong>Uw keuzes</strong>
        <p data-keuzes-samenvatting></p>
        <a href="#top" class="side-aanpassen" data-keuzes-aanpassen>Keuzes aanpassen</a>
      </div>
      <!-- Samenvatting meteen overnemen uit het keuzeblok (gevuld door het vroege script hierboven), zodat de zijnavigatie niet verspringt. -->
      <script is:inline>document.currentScript.previousElementSibling.querySelector('[data-keuzes-samenvatting]').textContent = document.querySelector('[data-keuzes] [data-keuzes-samenvatting]').textContent;</script>
      <strong>Op deze pagina</strong>
      <a href="#nu-doen" data-nav="nu-doen"><span class="n">→</span>Wat kunt u doen</a>
      <a href="#gemeente" data-nav="gemeente"><span class="n">1</span>Andere ingangen</a>
      <a href="#hulp" data-nav="hulp"><span class="n">2</span>Welke hulp</a>
      <a href="#tips" data-nav="tips"><span class="n">3</span>Therapievormen</a>
      <a href="#situaties" data-nav="situaties"><span class="n">4</span>Verdieping</a>
      <a href="#regelingen" data-nav="regelingen"><span class="n">5</span>Rechten en regelingen</a>
      <a href="#organisaties" data-nav="organisaties"><span class="n">6</span>Organisaties</a>
    </nav>
   </aside>
   <div>
    <!--
      Blok 1, "Wat kunt u doen": de stappen, met stap 1 voorop. Direct na stap 1 staat het contact van de eerste ingang
      (meestal het wijkteam), daarna de overige stappen, wat er in de gemeente bij die stappen hoort, en de brieven.
      De volgorde komt uit CSS (order), zodat de per-knelpunt- en per-gemeenteblokken los van elkaar kunnen blijven.
    -->
    <section class="section regelen antwoord" id="nu-doen" data-knelpunt-wrap hidden>
      {knelpunten.map((k) => (
        <div data-knelpunt-blok={k.id} hidden>
          <h2 class="o1"><span class="section-num">→</span>{k.id === 'beginnen' ? 'Wat kunt u doen' : `Wat kunt u doen: ${k.data.titel.toLowerCase()}`}</h2>
          {k.id === 'verhuizing' && (<>
            <Verdieping id="verhuizing" titel="Meer passend advies bij verhuizen" uitleg="Vult u in naar welke gemeente u gaat en wanneer, dan passen de stappen hieronder zich daarop aan: met het wijkteam van uw nieuwe gemeente en wat u wanneer regelt.">
              <label class="field"><span>Naar welke plaats of gemeente verhuist u?</span><input type="search" class="gemeente-keuze" placeholder="Bijvoorbeeld Almere" autocomplete="off" enterkeyhint="done" data-vh-naar /></label>
              <div class="field vd-datum"><label for="vh-datum">Wanneer verhuist u ongeveer?</label><span class="th-veld"><input type="text" inputmode="numeric" placeholder="dd-mm-jjjj" maxlength="10" autocomplete="off" id="vh-datum" data-th-invoer data-vh-datum /><button type="button" class="th-kalender" data-th-kalender aria-label="Kies een datum in de kalender"><span class="ico ico-calendar" aria-hidden="true"></span></button><input type="date" class="th-datum" data-th-datum tabindex="-1" aria-hidden="true" /></span><span class="meta vd-hint">Weet u de dag nog niet? Kies ongeveer de week.</span></div>
              <p class="meta vd-melding" data-vh-melding hidden></p>
            </Verdieping>
          </>)}
          {k.id === 'hulp-stopt' && (
            <Verdieping id="hulp-stopt" uitleg="Kies waarom de hulp stopt. Dan ziet u alleen de stappen die daarbij horen.">
              {/* Knoppen zoals bij de andere keuzes (KnelpuntKeuze): één keuze, nog eens klikken haalt hem weg. */}
              <div class="field vd-keuze"><span id="hs-reden-kop">Waarom stopt de hulp?</span>
                <div class="chips-select" role="group" aria-labelledby="hs-reden-kop">
                  {HULP_STOPT_REDEN.map((r) => <button type="button" class="chip-btn" aria-pressed="false" value={r.id} data-hs-reden data-label={r.label}>{r.label}</button>)}
                </div>
              </div>
            </Verdieping>
          )}
          <p class="o1 lead-klein" data-generieke-lead>{k.data.samenvatting}</p>
          {k.id === 'beginnen' && situaties.filter((sit) => sit.data.lichteStart || sit.data.aanvraagIngeklapt).map((sit) => <p class="o1 lead-klein" data-situatie-lead={sit.id} hidden>{sit.data.samenvatting}</p>)}
          {k.id === 'wachten' && <p class="o1 meta wacht-erger"><strong>Wordt het erger terwijl u wacht?</strong> Bel de huisarts. 's Avonds en in het weekend hoort u via hetzelfde nummer hoe u de huisartsenpost bereikt. <a href={`${base}/overzicht/?k=spoed`}>Het kan niet wachten →</a></p>}
          {k.id === 'spoed' ? <div class="o2"><SpoedNummers /></div> : (<>
            <ol class="steps stap-een o2">
              {k.id === 'beginnen' ? (<>
                <li data-generieke-stap><StapInhoud {...stapProps(k, hoofdStappen(k)[0])} /></li>
                {situaties.map((sit) => { const r0 = sit.data.routes[0]; return <li data-situatie-stap={sit.id} hidden><strong class="stap-lead">Begin bij {r0.beginBij ?? (sit.data.lichteStart && r0.type === 'wijkteam' ? 'het wijkteam, het Centrum voor Jeugd en Gezin (CJG) of het consultatiebureau van uw gemeente' : beginBij[r0.type])}.</strong> {r0.waarom}<OrgRegel orgs={genoemdIn(r0.waarom, organisaties)} /></li>; })}
              </>) : <>{k.id === 'verhuizing' && <li data-vh-binnen hidden></li>}<li><StapInhoud {...stapProps(k, hoofdStappen(k)[0])} />{vervolg(k, 0).length > 0 && <ol class="steps-sub">{vervolg(k, 0).map((v) => <li><StapInhoud {...stapProps(k, v)} /></li>)}</ol>}</li></>}
            </ol>
            {k.id === 'beginnen' && (
              <details class="o4 meer-brieven" data-aanvraag-inklap hidden>
                <summary>Is er toch jeugdhulp nodig? Zo vraagt u die aan</summary>
                <ol class="steps" start="2">{hoofdStappen(k).slice(1).map((st, i) => <li><StapInhoud {...stapProps(k, st)} />{vervolg(k, i + 1).length > 0 && <ol class="steps-sub">{vervolg(k, i + 1).map((v) => <li><StapInhoud {...stapProps(k, v)} /></li>)}</ol>}</li>)}</ol>
              </details>
            )}
            {k.data.stappen.length > 1 && <ol class="steps o4" data-aanvraag-stappen start="2">{hoofdStappen(k).slice(1).map((st, i) => <li><StapInhoud {...stapProps(k, st)} />{vervolg(k, i + 1).length > 0 && <ol class="steps-sub">{vervolg(k, i + 1).map((v) => <li><StapInhoud {...stapProps(k, v)} /></li>)}</ol>}</li>)}</ol>}
          </>)}
          
          {k.id === 'verkeerde-hulp' && (<>
            <p class="meta o5" data-tips-link hidden><a href="#tips">Welke andere vormen van hulp passen bij uw kind? Bekijk de therapievormen hieronder ↓</a></p>
            <p class="meta o5" data-tips-link-alg><a href={`${base}/therapievormen/`}>Welke andere vormen van hulp zijn er? Bekijk de therapievormen →</a></p>
          </>)}
          {k.id === 'geld' && <p class="meta o5"><a href={`${base}/landelijk/#05-financieel`}>Dubbele kinderbijslag en andere regelingen: wat u opschrijft en hoe u aanvraagt →</a></p>}
          {k.data.brieven.length > 0 && (<div class="o7" data-brieven-blok>
            <h3>Voorbeeldbrieven</h3>
            <div class="grid" data-generieke-brieven>{k.data.brieven.map((id) => { const b = brieven.find((x) => x.id === id); return b && <BriefKaart b={b} />; })}</div>
            {k.id === 'beginnen' && situaties.map((sit) => {
              // Per situatie: de brieven die bij de routes van die situatie horen, in volgorde van de routes. Lege lijst = generieke brieven tonen.
              const types = sit.data.routes.map((r) => r.type as string);
              // Brieven die bij een ander knelpunt horen (klacht, bezwaar, verhuizing) zijn geen startbrieven.
              const andere = new Set(knelpunten.filter((x) => x.id !== 'beginnen').flatMap((x) => x.data.brieven));
              const eigen = brieven.filter((b) => b.data.situaties.includes(sit.id) && types.includes(b.data.aan) && (!andere.has(b.id) || k.data.brieven.includes(b.id))).sort((a, b) => types.indexOf(a.data.aan) - types.indexOf(b.data.aan) || a.data.volgorde - b.data.volgorde);
              // Brieven voor de eerste route staan open; de rest staat ingeklapt onder "Andere brieven". Noemt stap 1 het wijkteam
              // als gelijkwaardige ingang (beginBij, bv. ADHD), dan staat de brief aan het wijkteam ook open.
              const r0 = sit.data.routes[0];
              const directTypes = [types[0], ...(r0.beginBij && /wijkteam/.test(r0.beginBij) ? ['wijkteam'] : [])];
              const direct = eigen.filter((b) => directTypes.includes(b.data.aan));
              const rest = eigen.filter((b) => !directTypes.includes(b.data.aan));
              return eigen.length > 0 && (
                <div data-situatie-brieven={sit.id} hidden>
                  <div class="grid">{(direct.length > 0 ? direct : eigen).map((b) => <BriefKaart b={b} />)}</div>
                  {direct.length > 0 && rest.length > 0 && (
                    <details class="meer-brieven">
                      <summary>Andere brieven bij deze situatie ({rest.length})</summary>
                      <p class="meta">Voor als u via een andere route begint, of later alsnog hulp aanvraagt.</p>
                      <div class="grid">{rest.map((b) => <BriefKaart b={b} />)}</div>
                    </details>
                  )}
                </div>
              );
            })}
          </div>)}
          
        </div>
      ))}

      <!-- Begint de situatie bij de huisarts of school? Dan onder stap 1 toch één regel met het wijkteam, als gelijkwaardige ingang (order 3). -->
      <!-- De blokken van de gekozen gemeente (data-gemeente-slot) komen uit src/pages/gemeente-blokken/[slug].astro, opgehaald door src/lib/gemeente-blokken.ts. -->
      <div class="o3" data-wijkteam-regel data-gemeente-slot="overzicht-wijkteam-regel"></div>

      <!-- Contact van de eerste ingang, direct onder stap 1 (order 3). Eén keer op de pagina; in blok 2 staat deze ingang niet nog eens. -->
      <div class="o3" data-eerste-contact data-gemeente-slot="overzicht-eerste-contact"></div>

      <!-- Wat er in de gemeente bij de stappen hoort (order 6): cliëntondersteuning, klacht, bezwaar, enz. Het wijkteam zelf staat al onder stap 1. -->
      <div class="o6" data-knelpunt-gemeente data-gemeente-slot="overzicht-handig">
        <div class="gemeente-blok" data-gemeente=""><p class="meta">Kies uw gemeente om de contactgegevens te zien.</p></div>
      </div>

      <div class="o5b">
        <div data-vs-leeftijd="0-4" hidden><p class="meta vs-leeftijd"><strong>Bij deze leeftijd:</strong> gaat de route via een arts, dan is dat de jeugdarts of jeugdverpleegkundige van het consultatiebureau. Die kent uw kind al en verwijst direct. Gaat de route via het wijkteam, vraag dan het consultatiebureau om het contact te leggen. School speelt nog geen rol.</p></div>
        <div data-vs-leeftijd="4-12" hidden><p class="meta vs-leeftijd"><strong>Bij deze leeftijd:</strong> informeer ook school. De intern begeleider ziet uw kind elke dag en kan het wijkteam of de jeugdarts helpen met wat hij of zij ziet. Let op leeftijdsgrenzen van regelingen, zoals vergoed dyslexieonderzoek tot 13 jaar.</p></div>
        <div data-vs-leeftijd="12-18" hidden><p class="meta vs-leeftijd"><strong>Bij deze leeftijd:</strong> uw kind beslist vanaf 12 mee en vanaf 16 grotendeels zelf. Hulpverleners delen dan minder met u. Neem uw kind mee in elke stap. Vanaf 16 hoort ook de overgang naar 18 erbij: <a href={`${base}/overzicht/?k=wordt-18`}>"Mijn kind wordt 18"</a>.</p></div>
        <div data-vs-leeftijd="18-99" hidden><p class="meta vs-leeftijd"><strong>Bij deze leeftijd:</strong> de Jeugdwet geldt niet meer, tenzij verlengde jeugdhulp is toegekend. Voor een volwassen kind loopt hulp via de Wmo van de gemeente, de zorgverzekering of de Wlz, en uw kind beslist zelf. Zie <a href={`${base}/overzicht/?k=wordt-18`}>"Mijn kind wordt 18"</a>.</p></div>
      </div>
    </section>

    <!-- Blok 2: de andere ingangen in de gemeente, elk één keer met contactgegevens. De ingang van blok 1 staat hier niet. -->
    <section class="section" id="gemeente">
      <h2><span class="section-num">1</span><span data-kop-gemeente>Andere ingangen</span></h2>
      <div class="gemeente-blok" data-gemeente=""><p class="empty">Kies uw gemeente om te zien waar u daar terechtkunt. De routes hieronder gelden in elke gemeente.</p></div>
      <div class="gemeente-blok" data-gemeente="_overig"><p>Uw gemeente staat nog niet op deze site. Zoek op de website van uw gemeente naar "jeugdhulp" of "wijkteam". De landelijke rechten en regelingen gelden ook voor u.</p></div>
      <div data-gemeente-slot="overzicht-routes"></div>
      <div data-routes-algemeen>
        {situaties.map((s) => s.data.routes.filter((r) => r.type !== 'spoed').map((r, i) => (
          <div class={`route ${r.type}`} data-situatie={s.id} hidden>{i === 0 && <span class="badge begin">Begin hier</span>} <span class="badge">{routeLabel[r.type]}</span> <span class="badge" style="background:var(--c-bg);color:var(--c-muted)">{s.data.titel}</span><p style="margin:.5rem 0 0">{r.waarom}</p></div>
        )))}
      </div>
    </section>

    <section class="section" id="hulp">
      <h2><span class="section-num">2</span>Welke hulp bestaat er?</h2>
      <ToegangLegenda />
      <div class="grid">
        {hulpsoorten.map((h) => (
          <HulpsoortKaart h={h} voorbeelden={false} data-hulpsoort={h.id} hidden {...(veelVormen(h.id) ? { naarTherapie: 'uw situatie', anker: '#tips', 'data-naar-tips': `${base}/hulpsoorten/${h.id}/` } : {})} />
        ))}
      </div>
    </section>

    <section class="section" id="tips" data-tips-wrap>
      <h2><span class="section-num">3</span>Welke therapievormen kunnen passen?</h2>
      <div class="grid gelijk" data-tip-grid>{therapie.map((t, i) => <div data-tip-situaties={t.data.situaties.join(' ')} data-tip-hulpsoorten={t.data.hulpsoorten.join(' ')} data-tip-rang={tipRang(t.id)} data-tip-i={i} data-van={t.data.leeftijd?.van ?? 0} data-tot={t.data.leeftijd?.tot ?? 99} hidden><TherapieKaart t={t} /></div>)}</div>
    </section>

    <section class="section" id="situaties">
      <h2><span class="section-num">4</span>Verdieping per situatie</h2>
      <div class="grid">
        {situaties.map((s) => (
          <a class="card link" href={`${base}/situaties/${s.id}/`} data-situatie={s.id} hidden>
            <h3>{afbreken(s.data.titel)}</h3>
            <p class="meta">{s.data.samenvatting}</p>
            <span class="arrow">Wat helpt en waar het misgaat →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section" id="regelingen">
      <h2><span class="section-num">5</span>Rechten en regelingen</h2>
      <ul class="linklist" data-gemeente-slot="overzicht-leerplicht">
        {situaties.map((s) => s.data.regelingen.map((r) => (
          <li data-situatie={s.id} hidden>{r.url ? <a href={r.url} target="_blank" rel="noopener"><Icon name="external" />{r.naam}</a> : <strong>{r.naam}</strong>}<p>{r.toelichting}</p></li>
        )))}
      </ul>
      <h3>Landelijke uitleg</h3>
      <ul>{landelijk.map((l) => <li data-landelijk={l.id} hidden><a href={`${base}/landelijk/#${l.id}`}>{l.data.titel}</a> – {l.data.samenvatting}</li>)}</ul>
    </section>

    <section class="section" id="organisaties">
      <h2><span class="section-num">6</span>Organisaties die hierbij passen</h2>
      <div class="grid">
        {organisaties.map((o) => (
          <div class="card" data-themas={j(o.data.themas)} hidden>
            <span class="badge">{o.data.soort}</span>
            <h3 style="margin-top:.6rem">{o.data.naam}</h3>
            <p>{o.data.omschrijving}</p>
            <Contact contact={{ naam: o.data.naam, url: o.data.url, telefoon: o.data.telefoon }} zonder={['naam']} class="kaal org-voet" />
          </div>
        ))}
      </div>
    </section>
    <!-- Bronnen van de gekozen vraag, onderaan zoals op alle pagina's; het script toont die van de gekozen vraag. -->
    {knelpunten.filter((k) => k.data.bronnen.length > 0).map((k) => <Sources bronnen={k.data.bronnen} laatstGecontroleerd={k.data.laatstGecontroleerd} data-knelpunt-bronnen={k.id} id={`bronnen-${k.id}`} hidden />)}
   </div>
  </div>
</Base>
<script is:inline set:html={`window.__jrSituaties = ${JSON.stringify(sitData)}; window.__jrKnelpunten = ${JSON.stringify(knelData)}; window.__jrNamen = ${JSON.stringify(namen)};`} />
<script>
  import { laadGemeente, laadNieuweGemeente } from '../lib/gemeente-blokken';
  import { dagenTot, leesDatum } from '../lib/termijnen';
  import { koppelDatumvelden } from '../lib/datumveld';
  import { koppelSuggesties } from '../lib/suggesties';
  type Sit = { themas: string[]; hulpsoorten: string[]; routes: string[]; landelijk: string[]; licht: boolean; jgz: boolean; inklap: boolean; rang: boolean; gelijk: boolean };
  const data = (window as any).__jrSituaties as Record<string, Sit>;
  const knel = (window as any).__jrKnelpunten as Record<string, { onderdelen: string[]; landelijk: string[]; zonderGemeente: boolean; wijkteamBovenaan: boolean }>;
  // Beginstand uit URL of localStorage; de keuzecomponenten sturen daarna events bij wijziging.
  const params = new URLSearchParams(location.search);
  let sel: string[] = (params.get('s') ?? localStorage.getItem('jr.situaties') ?? '').split(',').filter(Boolean);
  let gem = params.get('gemeente') ?? localStorage.getItem('jr.gemeente') ?? '';
  let kp = params.get('k') ?? localStorage.getItem('jr.knelpunt') ?? '';
  let lf = params.get('l') ?? localStorage.getItem('jr.leeftijd') ?? '';
  const BAND: Record<string, [number, number]> = { '0-4': [0, 4], '4-12': [4, 12], '12-18': [12, 18], '18-99': [18, 99] };
  const q = (s: string) => Array.from(document.querySelectorAll<HTMLElement>(s));
  const namen = (window as any).__jrNamen as { s: Record<string, string>; k: Record<string, string>; g: Record<string, string>; l: Record<string, string> };
  const keuzes = document.querySelector<HTMLDetailsElement>('[data-keuzes]');
  // Antwoord eerst: is er al iets gekozen, dan staan de keuzes ingeklapt en begint de pagina met het resultaat.
  // Uitklappen terwijl de balk vast staat: spring naar de keuzes, anders openen ze ver boven het scherm.
  keuzes?.addEventListener('toggle', () => { if (keuzes.open) requestAnimationFrame(() => keuzes.scrollIntoView({ block: 'start' })); });
  // "Keuzes aanpassen" (zijnavigatie en knop rechtsonder): keuzeblok openen; de toggle hierboven scrolt er dan naartoe.
  document.querySelectorAll<HTMLElement>('[data-keuzes-aanpassen]').forEach((el) => el.addEventListener('click', (e) => {
    if (!keuzes) return;
    e.preventDefault();
    if (keuzes.open) keuzes.scrollIntoView({ block: 'start' }); else keuzes.open = true;
  }));
  // Knop rechtsonder (alleen telefoon, zie CSS): pas tonen als het keuzeblok uit beeld is en er iets gekozen is.
  const knop = document.querySelector<HTMLElement>('[data-keuzes-knop]');
  if (keuzes && knop && 'IntersectionObserver' in window) new IntersectionObserver(([e]) => { knop.hidden = e.isIntersecting || !!document.querySelector('[data-inhoud][hidden]'); }).observe(keuzes);
  // Verdieping bij de verhuizing: naar welke gemeente en wanneer (beide optioneel). Uit de URL (?naar=, ?datum=) of van een
  // eerder bezoek; bij een wijziging gaan ze in de URL, zodat het overzicht te bewaren en te delen is.
  const VH_KEY = 'jr.verhuizing';
  const vhBewaard = (() => { try { return JSON.parse(localStorage.getItem(VH_KEY) ?? '{}'); } catch { return {}; } })();
  let naar: string = params.get('naar') ?? vhBewaard.naar ?? '';
  let verhuisdatum: string = params.get('datum') ?? vhBewaard.datum ?? '';
  if (!namen.g[naar]) naar = '';
  if (!/^\d{4}-\d{2}-\d{2}$/.test(verhuisdatum)) verhuisdatum = '';
  const vhBlok = document.querySelector<HTMLElement>('[data-verdieping="verhuizing"]');
  const naarVeld = vhBlok?.querySelector<HTMLInputElement>('[data-vh-naar]');
  const datumVeld = vhBlok?.querySelector<HTMLInputElement>('[data-vh-datum]');
  const vhMelding = vhBlok?.querySelector<HTMLElement>('[data-vh-melding]');
  // Plaatsnaam → gemeente: eerst de gemeenten zelf; bij het eerste gebruik ook de woonplaatsen (zoals bij de gemeentekeuze).
  // Een woonplaats in twee gemeenten alleen met de gemeente erbij ("Plaats (gemeente X)").
  const plaatsen = new Map(Object.entries(namen.g).map(([slug, naam]) => [naam.toLowerCase(), slug]));
  // Keuzes voor de suggestielijst (lib/suggesties.ts): eerst de gemeenten, na het laden ook de woonplaatsen.
  const plaatsLabels = Object.values(namen.g);
  const vhSuggesties = naarVeld ? koppelSuggesties(naarVeld, () => plaatsLabels) : null;
  let woonplaatsen: Promise<void> | null = null;
  const laadWoonplaatsen = () => (woonplaatsen ??= fetch(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/woonplaatsen.json`).then((r) => r.json()).then((paren: [string, string][]) => {
    const per = new Map<string, Set<string>>();
    paren.forEach(([plaats, slug]) => per.set(plaats.toLowerCase(), (per.get(plaats.toLowerCase()) ?? new Set()).add(slug)));
    const opties = paren.filter(([, slug]) => namen.g[slug]).map(([plaats, slug]) => {
      const label = `${plaats} (gemeente ${namen.g[slug]})`;
      plaatsen.set(label.toLowerCase(), slug);
      if (per.get(plaats.toLowerCase())!.size === 1 && !plaatsen.has(plaats.toLowerCase())) plaatsen.set(plaats.toLowerCase(), slug);
      // "Almere (gemeente Almere)" niet naast "Almere": dat is dezelfde keuze.
      return plaats === namen.g[slug] ? '' : label;
    }).filter(Boolean);
    plaatsLabels.push(...opties);
    vhSuggesties?.ververs();
  }).catch(() => { woonplaatsen = null; }));
  const bewaarVerhuizing = () => {
    if (naar || verhuisdatum) localStorage.setItem(VH_KEY, JSON.stringify({ naar, datum: verhuisdatum })); else localStorage.removeItem(VH_KEY);
    const u = new URL(location.href);
    if (naar) u.searchParams.set('naar', naar); else u.searchParams.delete('naar');
    if (verhuisdatum) u.searchParams.set('datum', verhuisdatum); else u.searchParams.delete('datum');
    history.replaceState(history.state, '', u);
  };
  const verhuizingGewijzigd = () => { bewaarVerhuizing(); laadNieuweGemeente(naar).then((ok) => ok && render()); };
  // Beide vragen beantwoord: inklappen tot de samenvatting, zodat de stappen hoger in beeld komen. Niet tijdens het typen van de plaats.
  const klapIn = () => { if (naar && verhuisdatum) vhBlok?.setAttribute('data-vd-ingeklapt', ''); };
  if (naarVeld && datumVeld) {
    naarVeld.value = namen.g[naar] ?? '';
    datumVeld.value = verhuisdatum ? verhuisdatum.split('-').reverse().join('-') : '';
    koppelDatumvelden();
    // Bij een tweede bezoek staat het antwoord voorop, niet de vragen.
    if (naar || verhuisdatum) vhBlok!.setAttribute('data-vd-ingeklapt', '');
    naarVeld.addEventListener('focus', laadWoonplaatsen);
    naarVeld.addEventListener('input', () => {
      const slug = plaatsen.get(naarVeld.value.trim().toLowerCase());
      if (vhMelding) vhMelding.hidden = true;
      if (slug && slug !== naar) { naar = slug; verhuizingGewijzigd(); }
    });
    // Pas bij verlaten van het veld (of Enter) melden dat een plaats onbekend is; tijdens het typen niet.
    naarVeld.addEventListener('change', async () => {
      const tekst = naarVeld.value.trim().toLowerCase();
      if (tekst) await laadWoonplaatsen();
      const slug = plaatsen.get(tekst) ?? '';
      if (vhMelding) {
        vhMelding.hidden = !tekst || !!slug;
        vhMelding.textContent = 'Deze plaats kennen we niet. Typ de eerste letters en kies uit de lijst die verschijnt.';
      }
      if (slug !== naar) { naar = slug; verhuizingGewijzigd(); }
      klapIn();
    });
    // dd-mm-jjjj (getypt of uit de kalender, zie lib/datumveld.ts); bewaard als jjjj-mm-dd.
    datumVeld.addEventListener('input', () => {
      const d = leesDatum(datumVeld.value);
      const iso = d ? `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}` : '';
      const fout = !d && datumVeld.value.replace(/\D/g, '').length >= 8;
      if (vhMelding) { vhMelding.hidden = !fout; if (fout) vhMelding.textContent = 'Vul de datum in als dd-mm-jjjj, bijvoorbeeld 01-12-2026.'; }
      // Leeg gemaakt: datum weg. Halverwege getypt: niets veranderen.
      if (iso !== verhuisdatum && (d || !datumVeld.value.trim())) { verhuisdatum = iso; verhuizingGewijzigd(); if (d) klapIn(); }
    });
    vhBlok!.querySelector('[data-vd-wissen]')?.addEventListener('click', () => {
      naar = ''; verhuisdatum = ''; naarVeld.value = ''; datumVeld.value = '';
      if (vhMelding) vhMelding.hidden = true;
      vhBlok!.removeAttribute('data-vd-ingeklapt');
      verhuizingGewijzigd();
    });
  }
  const VER_WEG = 91; // dagen; zie tekenVerhuizing
  const datumKort = (d: Date) => d.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
  const over = (n: number) => (n === 0 ? 'vandaag' : n === 1 ? 'morgen' : n < 14 ? `over ${n} dagen` : n < 120 ? `over ongeveer ${Math.round(n / 7)} weken` : `over ongeveer ${Math.round(n / 30)} maanden`);
  /** Tekent wat de antwoorden van de verdieping met de stappen doen. Alleen zichtbaar bij "Wij verhuizen". */
  const tekenVerhuizing = () => {
    const blok = document.querySelector<HTMLElement>('[data-knelpunt-blok="verhuizing"]');
    if (!vhBlok || !blok) return;
    const huidig = namen.g[gem] ?? '';
    const nieuweNaam = namen.g[naar] ?? '';
    const binnen = !!naar && naar === gem;
    const nieuw = !!naar && !binnen;
    const datum = verhuisdatum ? new Date(+verhuisdatum.slice(0, 4), +verhuisdatum.slice(5, 7) - 1, +verhuisdatum.slice(8, 10)) : null;
    const dagen = datum ? dagenTot(datum) : null;
    const verhuisd = dagen !== null && dagen < 0;
    // Nog ver weg: dan hoeft de ouder nu nog niets te doen. Drie maanden is een praktische vuistregel (geen wettelijke termijn):
    // genoeg tijd voor het overdragen, en dicht genoeg bij de verhuizing dat het besluit dan nog loopt.
    const verWeg = dagen !== null && dagen > VER_WEG;
    const beginOp = datum && new Date(datum.getFullYear(), datum.getMonth(), datum.getDate() - VER_WEG);
    const nogNiets = verWeg && beginOp ? ` U hoeft nu nog niets te regelen: begin rond ${datumKort(beginOp)}. Loopt het huidige besluit voor die tijd af? Vraag dan gewoon een nieuw besluit aan bij ${huidig || 'uw gemeente'}.` : '';
    const ingevuld = !!naar || !!datum;
    // Samenvatting boven de vragen (en ingeklapt in plaats van de vragen).
    const van = huidig && nieuw ? ` van ${huidig}` : '';
    const samenvatting = !ingevuld ? ''
      : binnen ? `U verhuist binnen ${huidig}. De gemeente blijft dezelfde, dus er hoeft niets overgedragen te worden.`
      : nieuw && datum && verhuisd ? `U bent op ${datumKort(datum)} verhuisd${van} naar ${nieuweNaam}. De stappen hieronder zijn daarop aangepast: meld u nu bij het wijkteam van ${nieuweNaam} (stap 3).`
      : nieuw && datum ? `U verhuist ${over(dagen!)}${van} naar ${nieuweNaam} (${datumKort(datum)}). De stappen hieronder zijn daarop aangepast.${nogNiets}`
      : nieuw ? `U verhuist${van} naar ${nieuweNaam}. Het wijkteam daar staat nu bij stap 3. Vul ook de datum in, dan ziet u wat u wanneer regelt.`
      : `${verhuisd ? `U bent op ${datumKort(datum!)} verhuisd` : `U verhuist ${over(dagen!)} (${datumKort(datum!)})`}.${nogNiets} Vul ook de nieuwe gemeente in, dan ziet u daar het wijkteam.`;
    const sv = vhBlok.querySelector<HTMLElement>('[data-vd-samenvatting]');
    if (sv) sv.textContent = samenvatting;
    vhBlok.querySelector<HTMLElement>('[data-vd-wissen]')!.hidden = !ingevuld;
    if (!ingevuld) vhBlok.removeAttribute('data-vd-ingeklapt');
    // Tijdlijn: alleen met een datum een kop per stap.
    const label: Record<string, string> = !datum ? {} : verhuisd
      ? { nu: `Nog niet gedaan? Doe het alsnog${huidig && nieuw ? ` bij ${huidig}` : ''}:`, voor: 'Nog niet gedaan? Doe het alsnog:', na: 'Doe dit nu:' }
      : { nu: verWeg ? `Vanaf ${datumKort(beginOp!)}, ongeveer drie maanden voor de verhuizing:` : `Nu, u verhuist ${over(dagen!)}:`, voor: 'Vóór de verhuizing:', na: `Rond de verhuizing (${datumKort(datum)}):` };
    blok.querySelectorAll<HTMLElement>('[data-moment]').forEach((e) => { const t = label[e.dataset.moment!]; e.hidden = !t; e.textContent = t ?? ''; });
    // Binnen dezelfde gemeente: geen overdracht en geen andere gemeente die verantwoordelijk kan worden, dus één stap.
    blok.querySelectorAll<HTMLElement>('[data-moment="nu"], [data-moment="voor"], [data-moment="na"], [data-moment="pleeg"]').forEach((e) => { e.closest('li')!.hidden = binnen; });
    blok.querySelectorAll<HTMLElement>('[data-vh-binnen]').forEach((li) => {
      li.hidden = !binnen;
      li.replaceChildren(Object.assign(document.createElement('strong'), { className: 'stap-lead', textContent: `U verhuist binnen ${huidig}.` }), ' Dan blijft de gemeente dezelfde en loopt de hulp gewoon door. Geef uw nieuwe adres door aan het wijkteam en aan de aanbieder van de hulp.');
    });
    // De nieuwe gemeente onder de stap "Meld u na uw inschrijving"; het huidige wijkteam staat onder stap 1.
    blok.querySelectorAll<HTMLElement>('[data-nieuw-stap]').forEach((e) => (e.hidden = !nieuw || !e.querySelector('[data-geladen]')));
  };
  // Verdieping bij "De hulp stopt": waarom stopt de hulp? Dan alleen de stappen bij die reden (?reden=, of van een eerder bezoek).
  const HS_KEY = 'jr.hulpstopt';
  const hsBlok = document.querySelector<HTMLElement>('[data-verdieping="hulp-stopt"]');
  const hsKeuzes = Array.from(hsBlok?.querySelectorAll<HTMLButtonElement>('[data-hs-reden]') ?? []);
  let reden = params.get('reden') ?? localStorage.getItem(HS_KEY) ?? '';
  if (!hsKeuzes.some((r) => r.value === reden)) reden = '';
  const redenGewijzigd = () => {
    hsKeuzes.forEach((r) => r.setAttribute('aria-pressed', String(r.value === reden)));
    if (reden) localStorage.setItem(HS_KEY, reden); else localStorage.removeItem(HS_KEY);
    const u = new URL(location.href);
    if (reden) u.searchParams.set('reden', reden); else u.searchParams.delete('reden');
    history.replaceState(history.state, '', u);
    render();
  };
  if (hsBlok) {
    hsKeuzes.forEach((r) => { r.setAttribute('aria-pressed', String(r.value === reden)); r.addEventListener('click', () => {
      reden = reden === r.value ? '' : r.value;
      // Na een keuze meteen inklappen tot de samenvatting, zodat de stappen hoger in beeld komen (persona-tests: Bas moest twee keer scrollen).
      if (reden) hsBlok.setAttribute('data-vd-ingeklapt', '');
      redenGewijzigd();
    }); });
    if (reden) hsBlok.setAttribute('data-vd-ingeklapt', '');
    hsBlok.querySelector('[data-vd-wissen]')?.addEventListener('click', () => {
      reden = '';
      hsBlok.removeAttribute('data-vd-ingeklapt');
      redenGewijzigd();
    });
  }
  const tekenHulpStopt = () => {
    const blok = document.querySelector<HTMLElement>('[data-knelpunt-blok="hulp-stopt"]');
    if (!hsBlok || !blok) return;
    const label = hsKeuzes.find((r) => r.value === reden)?.dataset.label ?? '';
    const sv = hsBlok.querySelector<HTMLElement>('[data-vd-samenvatting]');
    if (sv) sv.textContent = reden ? `U koos: ${label.toLowerCase()}.` : ''; // alleen ingeklapt zichtbaar (zie CSS); open ziet u de keuze zelf
    hsBlok.querySelector<HTMLElement>('[data-vd-wissen]')!.hidden = !reden;
    if (!reden) hsBlok.removeAttribute('data-vd-ingeklapt');
    blok.querySelectorAll<HTMLElement>('[data-reden]').forEach((e) => { e.closest('li')!.hidden = !!reden && e.dataset.reden !== reden; });
    // Valt stap 1 weg, dan begint de nummering van de overige stappen bij 1 (de lijst begint anders bij 2).
    const zonderEen = !!blok.querySelector('.stap-een') && Array.from(blok.querySelectorAll<HTMLElement>('.stap-een > li')).every((li) => li.hidden);
    blok.querySelectorAll<HTMLElement>('ol.o4[data-aanvraag-stappen]').forEach((ol) => (ol.style.counterReset = zonderEen ? 'step 0' : ''));
  };
  if (keuzes && (sel.length || kp || gem)) { keuzes.open = false; document.querySelectorAll<HTMLElement>('[data-intro]').forEach((e) => (e.hidden = true)); }
  const render = () => {
    const active = sel.filter((id) => data[id]);
    const themas = new Set(active.flatMap((id) => data[id].themas));
    const hulp = new Set(active.flatMap((id) => data[id].hulpsoorten));
    const land = new Set(active.flatMap((id) => data[id].landelijk));
    const hasThema = (el: HTMLElement) => (el.dataset.themas ?? '').split(' ').some((t) => themas.has(t));

    // Zonder gekozen knelpunt gelden de stappen van "Ik wil hulp aanvragen" (met de situatie als eerste stap).
    const kpGekozen = kp && knel[kp] ? kp : '';
    const iets = active.length > 0 || (!!gem && gem !== '_overig');
    const kpActive = kpGekozen || (iets ? 'beginnen' : '');
    const delen = [namen.g[gem], namen.k[kpGekozen], ...active.map((id) => namen.s[id]), namen.l[lf]].filter(Boolean);
    q('[data-keuzes-samenvatting]').forEach((e) => (e.textContent = delen.length ? delen.join(' · ') : 'nog niets gekozen'));
    if (kpActive) knel[kpActive].landelijk.forEach((l) => land.add(l));
    q('[data-leeg]').forEach((e) => (e.hidden = !!kpActive));
    q('[data-inhoud]').forEach((e) => (e.hidden = !kpActive));
    q('[data-knelpunt-wrap]').forEach((e) => (e.hidden = !kpActive));
    q('[data-knelpunt-blok]').forEach((e) => (e.hidden = e.dataset.knelpuntBlok !== kpActive));
    q('[data-knelpunt-bronnen]').forEach((e) => (e.hidden = e.dataset.knelpuntBronnen !== kpActive));
    // Landelijke vraag (zoals kinderbijslag): geen wijkteam, "hierbij handig" of andere ingangen van de gemeente,
    // en van de verdieping alleen de rechten en regelingen (geen hulpsoorten, therapievormen of organisaties).
    const zonderGemeente = !!kpActive && knel[kpActive].zonderGemeente;
    // Zorgen om een kind van een ander: de situatie gaat over dat kind, niet over hulp voor uw eigen kind. Dan geen rechten en
    // regelingen van de situatie (zoals "u mag de aanbieder kiezen") en geen leeftijdstips over school.
    const andermansKind = kpActive === 'zorgen-om-kind';
    q('#hulp, #situaties, #regelingen, #organisaties, #tips').forEach((e) => (e.hidden = active.length === 0 || andermansKind || (zonderGemeente && e.id !== 'regelingen')));
    // Lichte start (zoals scheiding): op zich geen reden voor jeugdhulp. Uitleg en CJG voorop, de aanvraag ingeklapt.
    const licht = kpActive === 'beginnen' && !!active[0] && data[active[0]].licht;
    // Ingeklapte aanvraag zonder lichte start (zoals onveilig thuis): eigen inleiding en de aanvraagstappen ingeklapt, het wijkteam blijft voorop.
    const inklap = kpActive === 'beginnen' && !!active[0] && data[active[0]].inklap;
    // Begint de situatie bij school (zoals thuiszitten), dan is "welke aanbieders kunt u kiezen" bij de start nog niet aan de orde.
    const schoolEerst = kpActive === 'beginnen' && !!active[0] && data[active[0]].routes[0] === 'school';
    // "De hulp stopt" met een andere reden dan een besluit van de gemeente: bezwaar (blok en brief) hoort er dan niet bij.
    const geenBezwaar = kpActive === 'hulp-stopt' && !!reden && reden !== 'gemeente';
    const onderdelen = !kpActive ? [] : licht ? ['toegang'] : knel[kpActive].onderdelen.filter((o) => !(schoolEerst && o === 'aanbieders') && !(geenBezwaar && o === 'bezwaar'));
    q('[data-eerste-contact], [data-knelpunt-gemeente]').forEach((e) => (e.hidden = zonderGemeente));
    // Staat de cliëntondersteuner al onder een stap, dan niet nog eens in "Hierbij handig".
    const coBijStap = !!kpActive && !!document.querySelector(`[data-knelpunt-blok="${kpActive}"] [data-co-stap] [data-geladen]`);
    const aanbiedersBijStap = !!kpActive && !!document.querySelector(`[data-knelpunt-blok="${kpActive}"] [data-aanbieders-stap] [data-geladen]`);
    q('[data-knelpunt-gemeente] .onderdeel').forEach((e) => (e.hidden = !onderdelen.includes(e.dataset.onderdeel!) || (coBijStap && e.dataset.onderdeel === 'clientondersteuning') || (aanbiedersBijStap && e.dataset.onderdeel === 'aanbieders')));
    q('[data-knelpunt-gemeente] .gemeente-blok').forEach((b) => (b.hidden = b.dataset.gemeente !== (q('[data-knelpunt-gemeente] .gemeente-blok').some((x) => x.dataset.gemeente === gem && gem) ? gem : '')));
    // Spoed zonder gemeente: geen melding "Kies uw gemeente" (bij nood moet niemand eerst een gemeente zoeken).
    if (kpActive === 'spoed' && (!gem || gem === '_overig')) q('[data-knelpunt-gemeente] .gemeente-blok[data-gemeente=""]').forEach((b) => (b.hidden = true));
    // Lege "Hierbij handig"-blokken verbergen.
    q('[data-knelpunt-gemeente] .gemeente-blok[data-gemeente]:not([data-gemeente=""])').forEach((b) => { if (!b.hidden) b.hidden = !Array.from(b.querySelectorAll<HTMLElement>('.onderdeel')).some((o) => !o.hidden); });
    const situatieWint = kpActive === 'beginnen' && !!active[0];
    q('[data-generieke-lead]').forEach((e) => (e.hidden = inklap));
    q('[data-situatie-lead]').forEach((e) => (e.hidden = !inklap || e.dataset.situatieLead !== active[0]));
    q('[data-aanvraag-stappen]').forEach((e) => (e.hidden = inklap));
    q('[data-aanvraag-inklap]').forEach((e) => (e.hidden = !inklap));
    q('[data-ec-cjg]').forEach((e) => (e.hidden = !licht));
    // Begint de situatie bij het consultatiebureau of de jeugdarts (zoals slaap) en heeft de gemeente geen CJG-blok: dan de JGZ boven het wijkteam.
    const jgzVoorop = licht && data[active[0]].jgz;
    q('[data-ec-jgz], [data-kop-jgz]').forEach((e) => (e.hidden = !jgzVoorop));
    q('[data-kop-standaard]').forEach((e) => (e.hidden = licht));
    q('[data-kop-licht]').forEach((e) => (e.hidden = !licht || (jgzVoorop && !!e.parentElement?.querySelector('[data-kop-jgz]'))));
    // Direct regelen: alleen de links bij de onderdelen van deze vraag. De rest staat op de pagina van de gemeente.
    q('[data-regel-soort]').forEach((e) => (e.hidden = !onderdelen.includes(e.dataset.regelSoort!)));
    q('[data-direct-regelen]').forEach((e) => (e.hidden = !e.querySelector('[data-regel-soort]:not([hidden])')));
    q('[data-meer-op-pagina]').forEach((e) => (e.hidden = onderdelen.includes('klacht') || onderdelen.includes('bezwaar')));
    q('[data-generieke-stap]').forEach((e) => (e.hidden = situatieWint));
    q('[data-situatie-stap]').forEach((e) => (e.hidden = !situatieWint || e.dataset.situatieStap !== active[0]));
    const eigenBrieven = situatieWint && q('[data-situatie-brieven]').some((e) => e.dataset.situatieBrieven === active[0]);
    q('[data-situatie-brieven]').forEach((e) => (e.hidden = !eigenBrieven || e.dataset.situatieBrieven !== active[0]));
    q('[data-generieke-brieven]').forEach((e) => (e.hidden = eigenBrieven));
    // Bij een lichte start geen aanvraagbrieven; wel brieven die bij de situatie zelf horen (zoals aan school).
    q('[data-brieven-blok]').forEach((e) => (e.hidden = (licht && !eigenBrieven) || (geenBezwaar && !!e.closest('[data-knelpunt-blok="hulp-stopt"]'))));
    // Eerste ingang: het wijkteam, tenzij de situatie bij de huisarts of school begint. Die staat dan alleen in blok 2.
    const eersteRoute = situatieWint ? data[active[0]].routes[0] : 'wijkteam';
    // Bij spoed en bij zorgen om een kind van een ander is het wijkteam niet de eerste plek om te bellen.
    const nietVoorEigenKind = kpActive === 'spoed' || kpActive === 'zorgen-om-kind';
    const wijkteamBovenaan = !nietVoorEigenKind && eersteRoute === 'wijkteam' && (!kpActive || knel[kpActive].wijkteamBovenaan);
    q('[data-eerste-contact] .gemeente-blok').forEach((b) => (b.hidden = b.dataset.gemeente !== gem || !wijkteamBovenaan));
    q('[data-leerplicht]').forEach((e) => (e.hidden = e.dataset.leerplicht !== gem || !active.includes('school-loopt-vast')));
    q('[data-wijkteam-regel] .gemeente-blok').forEach((b) => (b.hidden = b.dataset.gemeente !== gem || wijkteamBovenaan || nietVoorEigenKind || !situatieWint));
    // Noemt stap 1 het wijkteam al als gelijkwaardige ingang (bv. ADHD), dan niet "Liever eerst het wijkteam?" maar gewoon de contactgegevens.
    q('[data-wijkteam-regel]').forEach((e) => e.toggleAttribute('data-gelijk', situatieWint && !!data[active[0]]?.gelijk));
    // Modus van de contactkaart bovenaan: per vraag de juiste ingang (wijkteam, bezwaar of klacht).
    const MODUS: Record<string, string> = { verhuizing: 'verhuizing', afgewezen: 'bezwaar', vastgelopen: 'klacht', wachten: 'wachten' };
    q('#nu-doen').forEach((e) => (e.dataset.modus = MODUS[kpActive] ?? ''));
    // "Hier meldt u zich" alleen bij hulp aanvragen (of zonder vraag). Bij andere vragen kent de ouder het wijkteam al (wachten, uitbreiden, 18 worden …).
    const eigenKop = ['verhuizing', 'bezwaar', 'klacht'].includes(MODUS[kpActive] ?? '');
    q('#nu-doen').forEach((e) => (e.dataset.kop = kpActive && kpActive !== 'beginnen' && !eigenKop ? 'wijkteam' : ''));
    q('[data-vs-leeftijd]').forEach((e) => (e.hidden = e.dataset.vsLeeftijd !== lf || andermansKind));

    // Blok 2: alle ingangen behalve de eerste; bij een situatie in de volgorde van die situatie. Niet bij spoed.
    const volgorde = active[0] ? data[active[0]].routes : ['wijkteam', 'huisarts', 'school'];
    q('#gemeente').forEach((e) => (e.hidden = nietVoorEigenKind || zonderGemeente));
    q('[data-kop-gemeente]').forEach((e) => (e.textContent = namen.g[gem] ? (wijkteamBovenaan ? `Andere ingangen in ${namen.g[gem]}` : `Waar u terechtkunt in ${namen.g[gem]}`) : 'Waar u terechtkunt'));
    q('.routes-lijst [data-route]').forEach((e) => {
      const t = e.dataset.route!;
      const i = volgorde.indexOf(t);
      e.hidden = (wijkteamBovenaan && t === 'wijkteam') || (active.length > 0 && i < 0 && t !== 'wijkteam');
      e.style.order = String(i < 0 ? 9 : i); // alleen als sorteersleutel; de volgorde wordt hieronder in de HTML gezet
    });
    // Zijnavigatie volgt zichtbare secties
    q('[data-nav]').forEach((a) => { const t = document.getElementById(a.dataset.nav!); a.hidden = !t || t.hidden; });
    q('[data-inhoud] [data-situatie]').forEach((e) => (e.hidden = !active.includes(e.dataset.situatie!)));
    q('[data-hulpsoort]').forEach((e) => (e.hidden = !hulp.has(e.dataset.hulpsoort!)));
    q('[data-landelijk]').forEach((e) => (e.hidden = !land.has(e.dataset.landelijk!)));
    q('#organisaties [data-themas]').forEach((e) => (e.hidden = !hasThema(e)));
    const band = BAND[lf];
    // Zichtbaar als de leeftijdsrange van de vorm meer dan één jaar overlapt met de gekozen band.
    const inBand = (e: HTMLElement) => !band || (Number(e.dataset.van) < band[1] - 1 && Number(e.dataset.tot) > band[0] + 1);
    q('[data-tip-situaties]').forEach((e) => (e.hidden = !(e.dataset.tipSituaties ?? '').split(' ').some((id) => active.includes(id)) || !inBand(e)));
    q('[data-vs-leeftijd]').forEach((e) => (e.hidden = e.dataset.vsLeeftijd !== lf || andermansKind));
    // Therapievormen op volgorde van toepasbaarheid: per kaart de beste plek over de gekozen situaties met een volgorde
    // (zie lib/therapie.ts). Hoort de kaart bij een gekozen situatie zonder volgorde, dan na de eerste stappen; verder op alfabet.
    const NA_EERST = 100; // = begin van de groep "kan ook helpen" in rangVan
    const plek = (e: HTMLElement) => {
      const r = (e.dataset.tipRang ?? '').split(' ').filter(Boolean).map((x) => x.split(':')).filter(([sit]) => active.includes(sit)).map(([, n]) => Number(n));
      const tipSits = (e.dataset.tipSituaties ?? '').split(' ');
      if (active.some((id) => !data[id].rang && tipSits.includes(id))) r.push(NA_EERST);
      return r.length ? Math.min(...r) : 999;
    };
    const tipGrid = document.querySelector('[data-tip-grid]');
    q('[data-tip-situaties]').map((e) => [e, plek(e), Number(e.dataset.tipI)] as const).sort((a, b) => a[1] - b[1] || a[2] - b[2]).forEach(([e]) => tipGrid?.appendChild(e));
    q('[data-tips-wrap]').forEach((w) => (w.hidden = zonderGemeente || !q('[data-tip-situaties]').some((e) => !e.hidden)));
    const tipsZichtbaar = q('[data-tips-wrap]').some((w) => !w.hidden);
    // Kaart Behandeling: naar de therapievormen hieronder als daar een vorm uit die hulpsoort staat, anders naar de algemene pagina.
    q('a[data-naar-tips]').forEach((el) => {
      const kaart = el as HTMLAnchorElement;
      const id = kaart.dataset.hulpsoort!;
      const hier = tipsZichtbaar && q('[data-tip-hulpsoorten]').some((e) => !e.hidden && (e.dataset.tipHulpsoorten ?? '').split(' ').includes(id));
      kaart.href = hier ? '#tips' : kaart.dataset.naarTips!;
      const pijl = kaart.querySelector('.arrow'); if (pijl) pijl.textContent = hier ? 'Welke behandelingen passen bij uw situatie ↓' : 'Wat is het en hoe vraag ik het aan →';
    });
    q('[data-tips-link]').forEach((e) => (e.hidden = !tipsZichtbaar));
    q('[data-tips-link-alg]').forEach((e) => (e.hidden = tipsZichtbaar));

    // Nummers doortellen over de zichtbare secties (zijnavigatie én koppen), anders sprong de nummering bv. van → naar 4.
    q('[data-nav]').filter((a) => a.dataset.nav !== 'nu-doen').forEach((a) => {
      const t = document.getElementById(a.dataset.nav!);
      a.hidden = !t || t.hidden;
    });
    let nr = 0;
    q('[data-nav]').filter((a) => a.dataset.nav !== 'nu-doen' && !a.hidden).forEach((a) => {
      nr++;
      const n = a.querySelector('.n'); if (n) n.textContent = String(nr);
      const kop = document.getElementById(a.dataset.nav!)?.querySelector(':scope > h2 .section-num'); if (kop) kop.textContent = String(nr);
    });
    const known = q('#gemeente .gemeente-blok').some((b) => b.dataset.gemeente === gem && gem !== '');
    q('#gemeente .gemeente-blok').forEach((b) => (b.hidden = b.dataset.gemeente !== (known || gem === '_overig' ? gem : '')));
    q('[data-routes-algemeen]').forEach((e) => (e.hidden = known));
    // Lokale steun: eerst wat bij de gekozen situaties past (hooguit 4); is dat minder dan 2, dan aanvullen met hooguit 2 "voor alle gezinnen".
    // Zonder situatie alleen bij "Ik wil hulp aanvragen" (dan alleen de algemene). Het CJG vervalt als het CJG-blok al bovenaan staat.
    q('.gemeente-blok [data-lokaal-wrap]').forEach((w) => {
      const items = Array.from(w.querySelectorAll<HTMLElement>('[data-li]'));
      const lijst = w.querySelector('ul');
      const bruikbaar = items.filter((i) => !(licht && i.dataset.liCjg));
      const past = (i: HTMLElement) => i.dataset.liGelabeld ? (i.dataset.liSits ?? '').split(' ').some((id) => active.includes(id)) : hasThema(i);
      const specifiek = bruikbaar.filter(past).slice(0, 4);
      const magAlgemeen = active.length > 0 || kpActive === 'beginnen';
      const aanvulling = specifiek.length < 2 && magAlgemeen ? bruikbaar.filter((i) => i.dataset.liIedereen && !specifiek.includes(i)).slice(0, 2) : [];
      const tonen = [...specifiek, ...aanvulling];
      items.forEach((i) => (i.hidden = !tonen.includes(i)));
      tonen.forEach((i) => lijst?.appendChild(i));
      w.hidden = tonen.length === 0;
    });
    tekenVerhuizing();
    tekenHulpStopt();
    // Pas aan het eind: hieronder hangt af van wat hierboven zichtbaar is gemaakt.
    // Echte volgorde in de HTML (ook voor schermlezers): contact direct onder de kop, vóór de uitleg en de stappen
    // (persona-tests: ouders zoeken eerst wie ze moeten bellen); "hierbij handig" na de overige stappen.
    const blok = q('[data-knelpunt-blok]').find((e) => !e.hidden);
    if (blok) {
      const na1 = blok.querySelector('.stap-een') ?? blok.querySelector('.o2');
      const kop = blok.querySelector('h2');
      const ec = document.querySelector('[data-eerste-contact]');
      if (kop && ec) kop.after(ec);
      // Begint de situatie bij huisarts of school, dan staat het wijkteam direct onder stap 1 (persona-tests: stond onder de brieven).
      const wr = document.querySelector('[data-wijkteam-regel]');
      if (na1 && wr) na1.after(wr);
      // Na het laatste blok met stappen of links onder de stappen (bij "hulp aanvragen" staat de ingeklapte versie vóór de gewone lijst).
      const na2 = Array.from(blok.querySelectorAll('.o4, .o5')).pop() ?? na1;
      const hd = document.querySelector('[data-knelpunt-gemeente]');
      const lft = document.querySelector('.o5b');
      // Eerst de tip bij de leeftijd (hoort bij de stappen), dan "Hierbij handig".
      if (na2 && hd) { na2.after(hd); if (lft) hd.before(lft); }
    }
    // Blok 2 op volgorde zetten, en elk contact maar één keer tonen (ook niet als het al onder stap 1 staat).
    const gezien = new Set<string>();
    q('[data-eerste-contact] .gemeente-blok').filter((b) => !b.hidden).forEach((b) => b.querySelectorAll<HTMLAnchorElement>('a[href^="tel:"]').forEach((a) => gezien.add(a.getAttribute('href')!)));
    q('.routes-lijst').forEach((lijst) => {
      const rs = Array.from(lijst.querySelectorAll<HTMLElement>(':scope > [data-route]')).sort((x, y) => Number(x.style.order) - Number(y.style.order));
      const eerstAnders = lijst.querySelector(':scope > :not([data-route])');
      rs.forEach((r) => lijst.insertBefore(r, eerstAnders));
      if (lijst.hidden) return;
      // Het wijkteam eerst ontdubbelen: een contact dat ook bij het wijkteam hoort, blijft daar staan.
      [...rs].sort((x, y) => Number(y.dataset.route === 'wijkteam') - Number(x.dataset.route === 'wijkteam')).filter((r) => !r.hidden).forEach((r) => r.querySelectorAll<HTMLElement>('.contact').forEach((c) => {
        const sleutel = c.querySelector('a[href^="tel:"]')?.getAttribute('href') ?? c.querySelector('strong')?.textContent ?? '';
        c.hidden = !!sleutel && gezien.has(sleutel);
        if (sleutel) gezien.add(sleutel);
      }));
    });
    // Klaar met tekenen: de uitleg bij moeilijke woorden (Base.astro) kan nu de zichtbare tekst nalopen.
    document.dispatchEvent(new CustomEvent('jr:getekend'));
  };
  document.addEventListener('jr:situaties', (e) => { sel = (e as CustomEvent).detail; render(); });
  // Pas tekenen als de blokken van de gemeente er zijn; is er intussen een andere gekozen, dan tekent die.
  document.addEventListener('jr:gemeente', (e) => { gem = (e as CustomEvent).detail; laadGemeente(gem).then((ok) => ok && render()); });
  document.addEventListener('jr:knelpunt', (e) => { kp = (e as CustomEvent).detail; render(); });
  document.addEventListener('jr:leeftijd', (e) => { lf = (e as CustomEvent).detail; render(); });
  Promise.all([laadGemeente(gem), laadNieuweGemeente(naar)]).then(() => {
    render();
    document.documentElement.classList.remove('jr-laden');
  });
</script>
