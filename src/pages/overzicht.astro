---
/**
 * Mijn overzicht: combineert gekozen situaties met de gekozen gemeente.
 * Alles wordt statisch gerenderd; JavaScript toont alleen wat bij de keuze past. De blokken van de gekozen gemeente
 * worden los opgehaald (src/lib/gemeente-blokken.ts), anders zou deze pagina alle 342 gemeenten bevatten.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Contact from '../components/Contact.astro';
import GemeenteKeuze from '../components/GemeenteKeuze.astro';
import SituatieKeuze from '../components/SituatieKeuze.astro';
import KnelpuntKeuze from '../components/KnelpuntKeuze.astro';
import LeeftijdKeuze from '../components/LeeftijdKeuze.astro';
import BriefKaart from '../components/BriefKaart.astro';
import SpoedNummers from '../components/SpoedNummers.astro';
import TherapieKaart from '../components/TherapieKaart.astro';
import { getCollection } from 'astro:content';
import { routeLabel, beginBij, koppelThemas } from '../lib/routes';
import { rangVan, therapieVolgorde } from '../lib/therapie';
import Toegang from '../components/Toegang.astro';
import ToegangLegenda from '../components/ToegangLegenda.astro';
import { afbreken } from '../lib/afbreken';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
/** Landelijke organisaties die in de stappen van een knelpunt bij naam worden genoemd: hun nummer en website direct onder de stappen. */
const genoemd = (k: (typeof knelpunten)[number]) => {
  const tekst = k.data.stappen.join(' ');
  return organisaties.filter((o) => tekst.includes(o.data.naam.replace(/^Het /, '').replace(/ \(.*\)$/, '')));
};
/** Per stap de voorbeeldbrief die erbij hoort (alleen brieven van dit knelpunt, elke brief één keer): een link direct achter de stap. */
const STAP_BRIEF: [RegExp, string][] = [
  [/ingebrekestelling/i, 'ingebrekestelling'],
  [/brief waarin u bezwaar maakt/i, 'bezwaar-beschikking'],
  [/(dien|dient).{0,40}klacht/i, 'klacht-toegangsteam'],
  [/overdracht/i, 'verhuizing-overdracht'],
  [/één overleg/i, 'gezamenlijk-overleg'],
];
/** Korte naam in de link, zodat twee brieflinks bij elkaar niet hetzelfde heten. */
const BRIEF_LABEL: Record<string, string> = { ingebrekestelling: 'ingebrekestelling', 'bezwaar-beschikking': 'bezwaar', 'klacht-toegangsteam': 'klacht', 'verhuizing-overdracht': 'overdracht', 'gezamenlijk-overleg': 'gezamenlijk overleg' };
const briefBij = (k: (typeof knelpunten)[number]) => {
  const gebruikt = new Set<string>();
  return k.data.stappen.map((st) => {
    const hit = STAP_BRIEF.find(([re, id]) => re.test(st) && k.data.brieven.includes(id) && !gebruikt.has(id));
    if (!hit) return undefined;
    gebruikt.add(hit[1]);
    return brieven.find((b) => b.id === hit[1]);
  });
};
const situaties = (await getCollection('situaties')).sort((a, b) => a.data.volgorde - b.data.volgorde);
const hulpsoorten = (await getCollection('hulpsoorten')).sort((a, b) => a.data.volgorde - b.data.volgorde);
const organisaties = (await getCollection('organisaties')).sort((a, b) => a.data.naam.localeCompare(b.data.naam));
const gemeenten = (await getCollection('gemeenten')).sort((a, b) => a.data.naam.localeCompare(b.data.naam));
const therapie = (await getCollection('therapievormen')).sort((a, b) => a.data.naam.localeCompare(b.data.naam));
/** Per therapievorm de plek in de volgorde van elke situatie die er een heeft: "situatie:plek". Controleert ook de volgorde zelf. */
situaties.forEach((s) => therapieVolgorde(s, therapie));
const tipRang = (id: string) => situaties.map((s) => { const r = rangVan(s, id); return r === null ? '' : `${s.id}:${r}`; }).filter(Boolean).join(' ');
const knelpunten = (await getCollection('knelpunten')).sort((a, b) => a.data.volgorde - b.data.volgorde);
const brieven = (await getCollection('brieven'));
const knelData = Object.fromEntries(knelpunten.map((k) => [k.id, { onderdelen: k.data.gemeenteOnderdelen, landelijk: k.data.landelijk, zonderGemeente: k.data.zonderGemeente }]));
const landelijk = (await getCollection('landelijk')).sort((a, b) => a.data.volgorde - b.data.volgorde);
/** Compacte data voor de browser: per situatie de koppelsleutels. */
const sitData = Object.fromEntries(situaties.map((s) => [s.id, { themas: koppelThemas(s.data.themas), hulpsoorten: s.data.hulpsoorten, routes: s.data.routes.map((r) => r.type), landelijk: s.data.landelijk, licht: s.data.lichteStart, rang: !!s.data.therapievormen }]));
const j = (a: string[]) => a.join(' ');
/** Namen voor de samenvatting van de keuzes. */
const namen = { s: Object.fromEntries(situaties.map((x) => [x.id, x.data.titel])), k: Object.fromEntries(knelpunten.map((x) => [x.id, x.data.titel])), g: Object.fromEntries(gemeenten.map((x) => [x.id, x.data.naam])), l: { '0-4': 'jonger dan 4', '4-12': '4 tot 12 jaar', '12-18': '12 tot 18 jaar', '18-99': '18 of ouder' } as Record<string, string> };
---
<Base title="Mijn overzicht" noindex>
  <div class="page-head">
    <span class="eyebrow">Op maat</span>
    <h1>Mijn overzicht</h1>
    <p class="lead" data-intro>Kies uw gemeente en wat er speelt. U ziet dan alleen wat voor u van toepassing is.</p>
  </div>

  <details class="section regelen keuzes" id="top" data-keuzes>
    <summary><strong>Uw keuzes</strong> <span class="meta" data-keuzes-samenvatting>nog niets gekozen</span> <span class="keuzes-actie">aanpassen</span></summary>
    <div class="wegwijzer light"><GemeenteKeuze /><KnelpuntKeuze /><LeeftijdKeuze /><SituatieKeuze mode="inline" /></div>
    <p class="empty" data-leeg style="margin:1rem 0 0">Kies hierboven een situatie, of waar u staat met de gemeente.</p>
  </details>
  <!-- Meteen (niet pas na het laden van de scripts): open of dicht, en de samenvatting. Anders klapte het blok zichtbaar dicht en versprong de pagina. -->
  <script is:inline define:vars={{ namen }}>
    (() => {
      const p = new URLSearchParams(location.search);
      const v = (k, key) => p.get(k) ?? localStorage.getItem(key) ?? '';
      const s = v('s', 'jr.situaties').split(',').filter(Boolean), k = v('k', 'jr.knelpunt'), g = v('gemeente', 'jr.gemeente'), l = v('l', 'jr.leeftijd');
      const d = document.querySelector('[data-keuzes]');
      if (!(s.length || k || g)) { d.open = true; return; }
      document.querySelectorAll('[data-intro]').forEach((e) => (e.hidden = true));
      // Tot de inhoud getekend is de voettekst verbergen: anders staat die even in beeld en schuift dan weg.
      document.documentElement.classList.add('jr-laden');
      setTimeout(() => document.documentElement.classList.remove('jr-laden'), 3000);
      const delen = [namen.g[g], namen.k[k], ...s.map((id) => namen.s[id]), namen.l[l]].filter(Boolean);
      if (delen.length) d.querySelector('[data-keuzes-samenvatting]').textContent = delen.join(' · ');
    })();
  </script>

  <button type="button" class="keuzes-knop" data-keuzes-aanpassen data-keuzes-knop hidden>Keuzes aanpassen</button>
  <div data-inhoud hidden class="page-with-side">
   <aside class="side">
    <nav aria-label="Inhoud" data-zijnav>
      <div class="side-keuzes">
        <strong>Uw keuzes</strong>
        <p data-keuzes-samenvatting></p>
        <a href="#top" class="side-aanpassen" data-keuzes-aanpassen>Keuzes aanpassen</a>
      </div>
      <!-- Samenvatting meteen overnemen uit het keuzeblok (gevuld door het vroege script hierboven), zodat de zijnavigatie niet verspringt. -->
      <script is:inline>document.currentScript.previousElementSibling.querySelector('[data-keuzes-samenvatting]').textContent = document.querySelector('[data-keuzes] [data-keuzes-samenvatting]').textContent;</script>
      <strong>Op deze pagina</strong>
      <a href="#nu-doen" data-nav="nu-doen"><span class="n">→</span>Wat kunt u doen</a>
      <a href="#gemeente" data-nav="gemeente"><span class="n">1</span>Andere ingangen</a>
      <a href="#hulp" data-nav="hulp"><span class="n">2</span>Welke hulp</a>
      <a href="#situaties" data-nav="situaties"><span class="n">3</span>Verdieping</a>
      <a href="#regelingen" data-nav="regelingen"><span class="n">4</span>Rechten en regelingen</a>
      <a href="#tips" data-nav="tips"><span class="n">5</span>Therapievormen</a>
      <a href="#organisaties" data-nav="organisaties"><span class="n">6</span>Organisaties</a>
    </nav>
   </aside>
   <div>
    <!--
      Blok 1, "Wat kunt u doen": de stappen, met stap 1 voorop. Direct na stap 1 staat het contact van de eerste ingang
      (meestal het wijkteam), daarna de overige stappen, wat er in de gemeente bij die stappen hoort, en de brieven.
      De volgorde komt uit CSS (order), zodat de per-knelpunt- en per-gemeenteblokken los van elkaar kunnen blijven.
    -->
    <section class="section regelen antwoord" id="nu-doen" data-knelpunt-wrap hidden>
      {knelpunten.map((k) => (
        <div data-knelpunt-blok={k.id} hidden>
          <h2 class="o1"><span class="section-num">→</span>{k.id === 'beginnen' ? 'Wat kunt u doen' : `Wat kunt u doen: ${k.data.titel.toLowerCase()}`}</h2>
          <p class="o1 lead-klein" data-generieke-lead>{k.data.samenvatting}</p>
          {k.id === 'beginnen' && situaties.filter((sit) => sit.data.lichteStart).map((sit) => <p class="o1 lead-klein" data-situatie-lead={sit.id} hidden>{sit.data.samenvatting}</p>)}
          {k.id === 'wachten' && <p class="o1 meta wacht-erger"><strong>Wordt het erger terwijl u wacht?</strong> Bel de huisarts. 's Avonds en in het weekend hoort u via hetzelfde nummer hoe u de huisartsenpost bereikt. <a href={`${base}/overzicht/?k=spoed`}>Het kan niet wachten →</a></p>}
          {k.id === 'spoed' ? <div class="o2"><SpoedNummers /></div> : (<>
            <ol class="steps stap-een o2">
              {k.id === 'beginnen' ? (<>
                <li data-generieke-stap>{k.data.stappen[0]}</li>
                {situaties.map((sit) => { const r0 = sit.data.routes[0]; return <li data-situatie-stap={sit.id} hidden>Begin bij <strong>{sit.data.lichteStart && r0.type === 'wijkteam' ? 'het wijkteam, het Centrum voor Jeugd en Gezin (CJG) of het consultatiebureau van uw gemeente' : beginBij[r0.type]}</strong>. {r0.waarom}</li>; })}
              </>) : <li>{k.data.stappen[0]}{briefBij(k)[0] && <> <a class="stap-brief" href={`${base}/brieven/${briefBij(k)[0]!.id}/`}>Voorbeeldbrief {BRIEF_LABEL[briefBij(k)[0]!.id]} →</a></>}</li>}
            </ol>
            {k.id === 'beginnen' && (
              <details class="o4 meer-brieven" data-aanvraag-inklap hidden>
                <summary>Is er toch jeugdhulp nodig? Zo vraagt u die aan</summary>
                <ol class="steps" start="2">{k.data.stappen.slice(1).map((st) => <li>{st}</li>)}</ol>
              </details>
            )}
            {k.data.stappen.length > 1 && <ol class="steps o4" data-aanvraag-stappen start="2">{k.data.stappen.slice(1).map((st, i) => <li>{st}{briefBij(k)[i + 1] && <> <a class="stap-brief" href={`${base}/brieven/${briefBij(k)[i + 1]!.id}/`}>Voorbeeldbrief {BRIEF_LABEL[briefBij(k)[i + 1]!.id]} →</a></>}</li>)}</ol>}
          </>)}
          {k.id === 'beginnen' && <p class="meta o5" data-aanvraag-stappen><a href={`${base}/landelijk/#02b-hulp-vragen`}>Tips om uw vraag eerlijk en volledig te vertellen →</a></p>}
          {k.id !== 'spoed' && genoemd(k).length > 0 && <p class="meta o5 genoemd">{genoemd(k).map((o, i) => <>{i > 0 && ' · '}<strong>{o.data.naam.replace(/^Het /, '').replace(/ \(.*\)$/, '')}</strong>{o.data.telefoon && <> <a href={`tel:${o.data.telefoon.replace(/\s/g, '')}`}>{o.data.telefoon}</a></>} <a href={o.data.url} target="_blank" rel="noopener">website<span aria-hidden="true"> ↗</span></a></>)}</p>}
          {k.id === 'verkeerde-hulp' && (<>
            <p class="meta o5" data-tips-link hidden><a href="#tips">Welke andere vormen van hulp passen bij uw kind? Bekijk de therapievormen hieronder ↓</a></p>
            <p class="meta o5" data-tips-link-alg><a href={`${base}/therapievormen/`}>Welke andere vormen van hulp zijn er? Bekijk de therapievormen →</a></p>
          </>)}
          {k.id === 'geld' && <p class="meta o5"><a href={`${base}/landelijk/#05-financieel`}>Dubbele kinderbijslag en andere regelingen: wat u opschrijft en hoe u aanvraagt →</a></p>}
          {k.data.brieven.length > 0 && (<div class="o7" data-brieven-blok>
            <h3>Voorbeeldbrieven</h3>
            <div class="grid" data-generieke-brieven>{k.data.brieven.map((id) => { const b = brieven.find((x) => x.id === id); return b && <BriefKaart b={b} />; })}</div>
            {k.id === 'beginnen' && situaties.map((sit) => {
              // Per situatie: de brieven die bij de routes van die situatie horen, in volgorde van de routes. Lege lijst = generieke brieven tonen.
              const types = sit.data.routes.map((r) => r.type as string);
              // Brieven die bij een ander knelpunt horen (klacht, bezwaar, verhuizing) zijn geen startbrieven.
              const andere = new Set(knelpunten.filter((x) => x.id !== 'beginnen').flatMap((x) => x.data.brieven));
              const eigen = brieven.filter((b) => b.data.situaties.includes(sit.id) && types.includes(b.data.aan) && (!andere.has(b.id) || k.data.brieven.includes(b.id))).sort((a, b) => types.indexOf(a.data.aan) - types.indexOf(b.data.aan) || a.data.volgorde - b.data.volgorde);
              // Brieven voor de eerste route staan open; de rest staat ingeklapt onder "Andere brieven".
              const direct = eigen.filter((b) => b.data.aan === types[0]);
              const rest = eigen.filter((b) => b.data.aan !== types[0]);
              return eigen.length > 0 && (
                <div data-situatie-brieven={sit.id} hidden>
                  <div class="grid">{(direct.length > 0 ? direct : eigen).map((b) => <BriefKaart b={b} />)}</div>
                  {direct.length > 0 && rest.length > 0 && (
                    <details class="meer-brieven">
                      <summary>Andere brieven bij deze situatie ({rest.length})</summary>
                      <p class="meta">Voor als u via een andere route begint, of later alsnog hulp aanvraagt.</p>
                      <div class="grid">{rest.map((b) => <BriefKaart b={b} />)}</div>
                    </details>
                  )}
                </div>
              );
            })}
          </div>)}
          {k.data.bronnen.length > 0 && <p class="meta o8">Bronnen: {k.data.bronnen.map((b, i) => <><a href={b.url} target="_blank" rel="noopener">{b.titel}</a>{i < k.data.bronnen.length - 1 ? ' · ' : ''}</>)}</p>}
        </div>
      ))}

      <!-- Begint de situatie bij de huisarts of school? Dan onder stap 1 toch één regel met het wijkteam, als gelijkwaardige ingang (order 3). -->
      <!-- De blokken van de gekozen gemeente (data-gemeente-slot) komen uit src/pages/gemeente-blokken/[slug].astro, opgehaald door src/lib/gemeente-blokken.ts. -->
      <div class="o3" data-wijkteam-regel data-gemeente-slot="overzicht-wijkteam-regel"></div>

      <!-- Contact van de eerste ingang, direct onder stap 1 (order 3). Eén keer op de pagina; in blok 2 staat deze ingang niet nog eens. -->
      <div class="o3" data-eerste-contact data-gemeente-slot="overzicht-eerste-contact"></div>

      <!-- Wat er in de gemeente bij de stappen hoort (order 6): cliëntondersteuning, klacht, bezwaar, enz. Het wijkteam zelf staat al onder stap 1. -->
      <div class="o6" data-knelpunt-gemeente data-gemeente-slot="overzicht-handig">
        <div class="gemeente-blok" data-gemeente=""><p class="meta">Kies uw gemeente om de contactgegevens te zien.</p></div>
      </div>

      <div class="o5b">
        <div data-vs-leeftijd="0-4" hidden><p class="meta vs-leeftijd"><strong>Bij deze leeftijd:</strong> gaat de route via een arts, dan is dat de jeugdarts of jeugdverpleegkundige van het consultatiebureau. Die kent uw kind al en verwijst direct. Gaat de route via het wijkteam, vraag dan het consultatiebureau om het contact te leggen. School speelt nog geen rol.</p></div>
        <div data-vs-leeftijd="4-12" hidden><p class="meta vs-leeftijd"><strong>Bij deze leeftijd:</strong> informeer ook school. De intern begeleider ziet uw kind elke dag en kan het wijkteam of de jeugdarts helpen met wat hij of zij ziet. Let op leeftijdsgrenzen van regelingen, zoals vergoed dyslexieonderzoek tot 13 jaar.</p></div>
        <div data-vs-leeftijd="12-18" hidden><p class="meta vs-leeftijd"><strong>Bij deze leeftijd:</strong> uw kind beslist vanaf 12 mee en vanaf 16 grotendeels zelf. Hulpverleners delen dan minder met u. Neem uw kind mee in elke stap. Vanaf 16 hoort ook de overgang naar 18 erbij: <a href={`${base}/overzicht/?k=wordt-18`}>"Mijn kind wordt 18"</a>.</p></div>
        <div data-vs-leeftijd="18-99" hidden><p class="meta vs-leeftijd"><strong>Bij deze leeftijd:</strong> de Jeugdwet geldt niet meer, tenzij verlengde jeugdhulp is toegekend. Voor een volwassen kind loopt hulp via de Wmo van de gemeente, de zorgverzekering of de Wlz, en uw kind beslist zelf. Zie <a href={`${base}/overzicht/?k=wordt-18`}>"Mijn kind wordt 18"</a>.</p></div>
      </div>
    </section>

    <!-- Blok 2: de andere ingangen in de gemeente, elk één keer met contactgegevens. De ingang van blok 1 staat hier niet. -->
    <section class="section" id="gemeente">
      <h2><span class="section-num">1</span><span data-kop-gemeente>Andere ingangen</span></h2>
      <div class="gemeente-blok" data-gemeente=""><p class="empty">Kies uw gemeente om te zien waar u daar terechtkunt. De routes hieronder gelden in elke gemeente.</p></div>
      <div class="gemeente-blok" data-gemeente="_overig"><p>Uw gemeente staat nog niet op deze site. Zoek op de website van uw gemeente naar "jeugdhulp" of "wijkteam". De landelijke rechten en regelingen gelden ook voor u.</p></div>
      <div data-gemeente-slot="overzicht-routes"></div>
      <div data-routes-algemeen>
        {situaties.map((s) => s.data.routes.filter((r) => r.type !== 'spoed').map((r, i) => (
          <div class={`route ${r.type}`} data-situatie={s.id} hidden>{i === 0 && <span class="badge begin">Begin hier</span>} <span class="badge">{routeLabel[r.type]}</span> <span class="badge" style="background:var(--c-bg);color:var(--c-muted)">{s.data.titel}</span><p style="margin:.5rem 0 0">{r.waarom}</p></div>
        )))}
      </div>
    </section>

    <section class="section" id="hulp">
      <h2><span class="section-num">2</span>Welke hulp bestaat er?</h2>
      <ToegangLegenda />
      <div class="grid">
        {hulpsoorten.map((h) => (
          <div class="card" data-hulpsoort={h.id} hidden>
            <h3>{afbreken(h.data.naam)}</h3>
            <p>{h.data.omschrijving}</p>
            <Toegang waarde={h.data.beschikkingNodig} />
          </div>
        ))}
      </div>
    </section>

    <section class="section" id="situaties">
      <h2><span class="section-num">3</span>Verdieping per situatie</h2>
      <div class="grid">
        {situaties.map((s) => (
          <a class="card link" href={`${base}/situaties/${s.id}/`} data-situatie={s.id} hidden>
            <h3>{afbreken(s.data.titel)}</h3>
            <p class="meta">{s.data.samenvatting}</p>
            <span class="arrow">Wat helpt en waar het misgaat →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section" id="regelingen">
      <h2><span class="section-num">4</span>Rechten en regelingen</h2>
      <ul class="linklist" data-gemeente-slot="overzicht-leerplicht">
        {situaties.map((s) => s.data.regelingen.map((r) => (
          <li data-situatie={s.id} hidden>{r.url ? <a href={r.url} target="_blank" rel="noopener"><Icon name="external" />{r.naam}</a> : <strong>{r.naam}</strong>}<p>{r.toelichting}</p></li>
        )))}
      </ul>
      <h3>Landelijke uitleg</h3>
      <ul>{landelijk.map((l) => <li data-landelijk={l.id} hidden><a href={`${base}/landelijk/#${l.id}`}>{l.data.titel}</a> – {l.data.samenvatting}</li>)}</ul>
    </section>

    <section class="section" id="tips" data-tips-wrap>
      <h2><span class="section-num">5</span>Welke therapievormen kunnen passen?</h2>
      <div class="grid gelijk" data-tip-grid>{therapie.map((t, i) => <div data-tip-situaties={t.data.situaties.join(' ')} data-tip-rang={tipRang(t.id)} data-tip-i={i} data-van={t.data.leeftijd?.van ?? 0} data-tot={t.data.leeftijd?.tot ?? 99} hidden><TherapieKaart t={t} /></div>)}</div>
    </section>

    <section class="section" id="organisaties">
      <h2><span class="section-num">6</span>Organisaties die hierbij passen</h2>
      <div class="grid">
        {organisaties.map((o) => (
          <div class="card" data-themas={j(o.data.themas)} hidden>
            <span class="badge">{o.data.soort}</span>
            <h3 style="margin-top:.6rem">{o.data.naam}</h3>
            <p>{o.data.omschrijving}</p>
            <Contact contact={{ naam: o.data.naam, url: o.data.url, telefoon: o.data.telefoon }} zonder={['naam']} class="kaal org-voet" />
          </div>
        ))}
      </div>
    </section>
   </div>
  </div>
</Base>
<script is:inline set:html={`window.__jrSituaties = ${JSON.stringify(sitData)}; window.__jrKnelpunten = ${JSON.stringify(knelData)}; window.__jrNamen = ${JSON.stringify(namen)};`} />
<script>
  import { laadGemeente } from '../lib/gemeente-blokken';
  type Sit = { themas: string[]; hulpsoorten: string[]; routes: string[]; landelijk: string[]; licht: boolean; rang: boolean };
  const data = (window as any).__jrSituaties as Record<string, Sit>;
  const knel = (window as any).__jrKnelpunten as Record<string, { onderdelen: string[]; landelijk: string[]; zonderGemeente: boolean }>;
  // Beginstand uit URL of localStorage; de keuzecomponenten sturen daarna events bij wijziging.
  const params = new URLSearchParams(location.search);
  let sel: string[] = (params.get('s') ?? localStorage.getItem('jr.situaties') ?? '').split(',').filter(Boolean);
  let gem = params.get('gemeente') ?? localStorage.getItem('jr.gemeente') ?? '';
  let kp = params.get('k') ?? localStorage.getItem('jr.knelpunt') ?? '';
  let lf = params.get('l') ?? localStorage.getItem('jr.leeftijd') ?? '';
  const BAND: Record<string, [number, number]> = { '0-4': [0, 4], '4-12': [4, 12], '12-18': [12, 18], '18-99': [18, 99] };
  const q = (s: string) => Array.from(document.querySelectorAll<HTMLElement>(s));
  const namen = (window as any).__jrNamen as { s: Record<string, string>; k: Record<string, string>; g: Record<string, string>; l: Record<string, string> };
  const keuzes = document.querySelector<HTMLDetailsElement>('[data-keuzes]');
  // Antwoord eerst: is er al iets gekozen, dan staan de keuzes ingeklapt en begint de pagina met het resultaat.
  // Uitklappen terwijl de balk vast staat: spring naar de keuzes, anders openen ze ver boven het scherm.
  keuzes?.addEventListener('toggle', () => { if (keuzes.open) requestAnimationFrame(() => keuzes.scrollIntoView({ block: 'start' })); });
  // "Keuzes aanpassen" (zijnavigatie en knop rechtsonder): keuzeblok openen; de toggle hierboven scrolt er dan naartoe.
  document.querySelectorAll<HTMLElement>('[data-keuzes-aanpassen]').forEach((el) => el.addEventListener('click', (e) => {
    if (!keuzes) return;
    e.preventDefault();
    if (keuzes.open) keuzes.scrollIntoView({ block: 'start' }); else keuzes.open = true;
  }));
  // Knop rechtsonder (alleen telefoon, zie CSS): pas tonen als het keuzeblok uit beeld is en er iets gekozen is.
  const knop = document.querySelector<HTMLElement>('[data-keuzes-knop]');
  if (keuzes && knop && 'IntersectionObserver' in window) new IntersectionObserver(([e]) => { knop.hidden = e.isIntersecting || !!document.querySelector('[data-inhoud][hidden]'); }).observe(keuzes);
  if (keuzes && (sel.length || kp || gem)) { keuzes.open = false; document.querySelectorAll<HTMLElement>('[data-intro]').forEach((e) => (e.hidden = true)); }
  const render = () => {
    const active = sel.filter((id) => data[id]);
    const themas = new Set(active.flatMap((id) => data[id].themas));
    const hulp = new Set(active.flatMap((id) => data[id].hulpsoorten));
    const routes = new Set(active.flatMap((id) => data[id].routes));
    const land = new Set(active.flatMap((id) => data[id].landelijk));
    const hasThema = (el: HTMLElement) => (el.dataset.themas ?? '').split(' ').some((t) => themas.has(t));

    // Zonder gekozen knelpunt gelden de stappen van "Ik wil hulp aanvragen" (met de situatie als eerste stap).
    const kpGekozen = kp && knel[kp] ? kp : '';
    const iets = active.length > 0 || (!!gem && gem !== '_overig');
    const kpActive = kpGekozen || (iets ? 'beginnen' : '');
    const delen = [namen.g[gem], namen.k[kpGekozen], ...active.map((id) => namen.s[id]), namen.l[lf]].filter(Boolean);
    q('[data-keuzes-samenvatting]').forEach((e) => (e.textContent = delen.length ? delen.join(' · ') : 'nog niets gekozen'));
    if (kpActive) knel[kpActive].landelijk.forEach((l) => land.add(l));
    q('[data-leeg]').forEach((e) => (e.hidden = !!kpActive));
    q('[data-inhoud]').forEach((e) => (e.hidden = !kpActive));
    q('[data-knelpunt-wrap]').forEach((e) => (e.hidden = !kpActive));
    q('[data-knelpunt-blok]').forEach((e) => (e.hidden = e.dataset.knelpuntBlok !== kpActive));
    // Landelijke vraag (zoals kinderbijslag): geen wijkteam, "hierbij handig" of andere ingangen van de gemeente,
    // en van de verdieping alleen de rechten en regelingen (geen hulpsoorten, therapievormen of organisaties).
    const zonderGemeente = !!kpActive && knel[kpActive].zonderGemeente;
    // Zorgen om een kind van een ander: de situatie gaat over dat kind, niet over hulp voor uw eigen kind. Dan geen rechten en
    // regelingen van de situatie (zoals "u mag de aanbieder kiezen") en geen leeftijdstips over school.
    const andermansKind = kpActive === 'zorgen-om-kind';
    q('#hulp, #situaties, #regelingen, #organisaties, #tips').forEach((e) => (e.hidden = active.length === 0 || andermansKind || (zonderGemeente && e.id !== 'regelingen')));
    // Lichte start (zoals scheiding): op zich geen reden voor jeugdhulp. Uitleg en CJG voorop, de aanvraag ingeklapt.
    const licht = kpActive === 'beginnen' && !!active[0] && data[active[0]].licht;
    const onderdelen = !kpActive ? [] : licht ? ['toegang'] : knel[kpActive].onderdelen;
    q('[data-eerste-contact], [data-knelpunt-gemeente]').forEach((e) => (e.hidden = zonderGemeente));
    q('[data-knelpunt-gemeente] .onderdeel').forEach((e) => (e.hidden = !onderdelen.includes(e.dataset.onderdeel!)));
    q('[data-knelpunt-gemeente] .gemeente-blok').forEach((b) => (b.hidden = b.dataset.gemeente !== (q('[data-knelpunt-gemeente] .gemeente-blok').some((x) => x.dataset.gemeente === gem && gem) ? gem : '')));
    // Spoed zonder gemeente: geen melding "Kies uw gemeente" (bij nood moet niemand eerst een gemeente zoeken).
    if (kpActive === 'spoed' && (!gem || gem === '_overig')) q('[data-knelpunt-gemeente] .gemeente-blok[data-gemeente=""]').forEach((b) => (b.hidden = true));
    // Lege "Hierbij handig"-blokken verbergen.
    q('[data-knelpunt-gemeente] .gemeente-blok[data-gemeente]:not([data-gemeente=""])').forEach((b) => { if (!b.hidden) b.hidden = !Array.from(b.querySelectorAll<HTMLElement>('.onderdeel')).some((o) => !o.hidden); });
    const situatieWint = kpActive === 'beginnen' && !!active[0];
    q('[data-generieke-lead]').forEach((e) => (e.hidden = licht));
    q('[data-situatie-lead]').forEach((e) => (e.hidden = !licht || e.dataset.situatieLead !== active[0]));
    q('[data-aanvraag-stappen]').forEach((e) => (e.hidden = licht));
    q('[data-aanvraag-inklap]').forEach((e) => (e.hidden = !licht));
    q('[data-ec-cjg]').forEach((e) => (e.hidden = !licht));
    q('[data-kop-standaard]').forEach((e) => (e.hidden = licht));
    q('[data-kop-licht]').forEach((e) => (e.hidden = !licht));
    // Direct regelen: alleen de links bij de onderdelen van deze vraag. De rest staat op de pagina van de gemeente.
    q('[data-regel-soort]').forEach((e) => (e.hidden = !onderdelen.includes(e.dataset.regelSoort!)));
    q('[data-direct-regelen]').forEach((e) => (e.hidden = !e.querySelector('[data-regel-soort]:not([hidden])')));
    q('[data-meer-op-pagina]').forEach((e) => (e.hidden = onderdelen.includes('klacht') || onderdelen.includes('bezwaar')));
    q('[data-generieke-stap]').forEach((e) => (e.hidden = situatieWint));
    q('[data-situatie-stap]').forEach((e) => (e.hidden = !situatieWint || e.dataset.situatieStap !== active[0]));
    const eigenBrieven = situatieWint && q('[data-situatie-brieven]').some((e) => e.dataset.situatieBrieven === active[0]);
    q('[data-situatie-brieven]').forEach((e) => (e.hidden = !eigenBrieven || e.dataset.situatieBrieven !== active[0]));
    q('[data-generieke-brieven]').forEach((e) => (e.hidden = eigenBrieven));
    // Bij een lichte start geen aanvraagbrieven; wel brieven die bij de situatie zelf horen (zoals aan school).
    q('[data-brieven-blok]').forEach((e) => (e.hidden = licht && !eigenBrieven));
    // Eerste ingang: het wijkteam, tenzij de situatie bij de huisarts of school begint. Die staat dan alleen in blok 2.
    const eersteRoute = situatieWint ? data[active[0]].routes[0] : 'wijkteam';
    // Bij spoed en bij zorgen om een kind van een ander is het wijkteam niet de eerste plek om te bellen.
    const nietVoorEigenKind = kpActive === 'spoed' || kpActive === 'zorgen-om-kind';
    const wijkteamBovenaan = !nietVoorEigenKind && eersteRoute === 'wijkteam';
    q('[data-eerste-contact] .gemeente-blok').forEach((b) => (b.hidden = b.dataset.gemeente !== gem || !wijkteamBovenaan));
    q('[data-leerplicht]').forEach((e) => (e.hidden = e.dataset.leerplicht !== gem || !active.includes('school-loopt-vast')));
    q('[data-wijkteam-regel] .gemeente-blok').forEach((b) => (b.hidden = b.dataset.gemeente !== gem || wijkteamBovenaan || nietVoorEigenKind || !situatieWint));
    // Modus van de contactkaart bovenaan: per vraag de juiste ingang (wijkteam, bezwaar of klacht).
    const MODUS: Record<string, string> = { verhuizing: 'verhuizing', afgewezen: 'bezwaar', vastgelopen: 'klacht', wachten: 'wachten' };
    q('#nu-doen').forEach((e) => (e.dataset.modus = MODUS[kpActive] ?? ''));
    q('[data-vs-leeftijd]').forEach((e) => (e.hidden = e.dataset.vsLeeftijd !== lf || andermansKind));

    // Blok 2: alle ingangen behalve de eerste; bij een situatie in de volgorde van die situatie. Niet bij spoed.
    const volgorde = active[0] ? data[active[0]].routes : ['wijkteam', 'huisarts', 'school'];
    q('#gemeente').forEach((e) => (e.hidden = nietVoorEigenKind || zonderGemeente));
    q('[data-kop-gemeente]').forEach((e) => (e.textContent = namen.g[gem] ? (wijkteamBovenaan ? `Andere ingangen in ${namen.g[gem]}` : `Waar u terechtkunt in ${namen.g[gem]}`) : 'Waar u terechtkunt'));
    q('.routes-lijst [data-route]').forEach((e) => {
      const t = e.dataset.route!;
      const i = volgorde.indexOf(t);
      e.hidden = (wijkteamBovenaan && t === 'wijkteam') || (active.length > 0 && i < 0 && t !== 'wijkteam');
      e.style.order = String(i < 0 ? 9 : i); // alleen als sorteersleutel; de volgorde wordt hieronder in de HTML gezet
    });
    // Zijnavigatie volgt zichtbare secties
    q('[data-nav]').forEach((a) => { const t = document.getElementById(a.dataset.nav!); a.hidden = !t || t.hidden; });
    q('[data-inhoud] [data-situatie]').forEach((e) => (e.hidden = !active.includes(e.dataset.situatie!)));
    q('[data-hulpsoort]').forEach((e) => (e.hidden = !hulp.has(e.dataset.hulpsoort!)));
    q('[data-landelijk]').forEach((e) => (e.hidden = !land.has(e.dataset.landelijk!)));
    q('#organisaties [data-themas]').forEach((e) => (e.hidden = !hasThema(e)));
    const band = BAND[lf];
    // Zichtbaar als de leeftijdsrange van de vorm meer dan één jaar overlapt met de gekozen band.
    const inBand = (e: HTMLElement) => !band || (Number(e.dataset.van) < band[1] - 1 && Number(e.dataset.tot) > band[0] + 1);
    q('[data-tip-situaties]').forEach((e) => (e.hidden = !(e.dataset.tipSituaties ?? '').split(' ').some((id) => active.includes(id)) || !inBand(e)));
    q('[data-vs-leeftijd]').forEach((e) => (e.hidden = e.dataset.vsLeeftijd !== lf || andermansKind));
    // Therapievormen op volgorde van toepasbaarheid: per kaart de beste plek over de gekozen situaties met een volgorde
    // (zie lib/therapie.ts). Hoort de kaart bij een gekozen situatie zonder volgorde, dan na de eerste stappen; verder op alfabet.
    const NA_EERST = 100; // = begin van de groep "kan ook helpen" in rangVan
    const plek = (e: HTMLElement) => {
      const r = (e.dataset.tipRang ?? '').split(' ').filter(Boolean).map((x) => x.split(':')).filter(([sit]) => active.includes(sit)).map(([, n]) => Number(n));
      const tipSits = (e.dataset.tipSituaties ?? '').split(' ');
      if (active.some((id) => !data[id].rang && tipSits.includes(id))) r.push(NA_EERST);
      return r.length ? Math.min(...r) : 999;
    };
    const tipGrid = document.querySelector('[data-tip-grid]');
    q('[data-tip-situaties]').map((e) => [e, plek(e), Number(e.dataset.tipI)] as const).sort((a, b) => a[1] - b[1] || a[2] - b[2]).forEach(([e]) => tipGrid?.appendChild(e));
    q('[data-tips-wrap]').forEach((w) => (w.hidden = zonderGemeente || !q('[data-tip-situaties]').some((e) => !e.hidden)));
    const tipsZichtbaar = q('[data-tips-wrap]').some((w) => !w.hidden);
    q('[data-tips-link]').forEach((e) => (e.hidden = !tipsZichtbaar));
    q('[data-tips-link-alg]').forEach((e) => (e.hidden = tipsZichtbaar));

    // Nummers doortellen over de zichtbare secties (zijnavigatie én koppen), anders sprong de nummering bv. van → naar 4.
    q('[data-nav]').filter((a) => a.dataset.nav !== 'nu-doen').forEach((a) => {
      const t = document.getElementById(a.dataset.nav!);
      a.hidden = !t || t.hidden;
    });
    let nr = 0;
    q('[data-nav]').filter((a) => a.dataset.nav !== 'nu-doen' && !a.hidden).forEach((a) => {
      nr++;
      const n = a.querySelector('.n'); if (n) n.textContent = String(nr);
      const kop = document.getElementById(a.dataset.nav!)?.querySelector(':scope > h2 .section-num'); if (kop) kop.textContent = String(nr);
    });
    const known = q('#gemeente .gemeente-blok').some((b) => b.dataset.gemeente === gem && gem !== '');
    q('#gemeente .gemeente-blok').forEach((b) => (b.hidden = b.dataset.gemeente !== (known || gem === '_overig' ? gem : '')));
    q('[data-routes-algemeen]').forEach((e) => (e.hidden = known));
    // Lokale steun: eerst wat bij de gekozen situaties past (hooguit 4); is dat minder dan 2, dan aanvullen met hooguit 2 "voor alle gezinnen".
    // Zonder situatie alleen bij "Ik wil hulp aanvragen" (dan alleen de algemene). Het CJG vervalt als het CJG-blok al bovenaan staat.
    q('.gemeente-blok [data-lokaal-wrap]').forEach((w) => {
      const items = Array.from(w.querySelectorAll<HTMLElement>('[data-li]'));
      const lijst = w.querySelector('ul');
      const bruikbaar = items.filter((i) => !(licht && i.dataset.liCjg));
      const past = (i: HTMLElement) => i.dataset.liGelabeld ? (i.dataset.liSits ?? '').split(' ').some((id) => active.includes(id)) : hasThema(i);
      const specifiek = bruikbaar.filter(past).slice(0, 4);
      const magAlgemeen = active.length > 0 || kpActive === 'beginnen';
      const aanvulling = specifiek.length < 2 && magAlgemeen ? bruikbaar.filter((i) => i.dataset.liIedereen && !specifiek.includes(i)).slice(0, 2) : [];
      const tonen = [...specifiek, ...aanvulling];
      items.forEach((i) => (i.hidden = !tonen.includes(i)));
      tonen.forEach((i) => lijst?.appendChild(i));
      w.hidden = tonen.length === 0;
    });
    // Pas aan het eind: hieronder hangt af van wat hierboven zichtbaar is gemaakt.
    // Echte volgorde in de HTML (ook voor schermlezers): contact direct onder de kop, vóór de uitleg en de stappen
    // (persona-tests: ouders zoeken eerst wie ze moeten bellen); "hierbij handig" na de overige stappen.
    const blok = q('[data-knelpunt-blok]').find((e) => !e.hidden);
    if (blok) {
      const na1 = blok.querySelector('.stap-een') ?? blok.querySelector('.o2');
      const kop = blok.querySelector('h2');
      const ec = document.querySelector('[data-eerste-contact]');
      if (kop && ec) kop.after(ec);
      // Begint de situatie bij huisarts of school, dan staat het wijkteam direct onder stap 1 (persona-tests: stond onder de brieven).
      const wr = document.querySelector('[data-wijkteam-regel]');
      if (na1 && wr) na1.after(wr);
      const na2 = blok.querySelector('.o5') ?? blok.querySelector('.o4') ?? na1;
      const hd = document.querySelector('[data-knelpunt-gemeente]');
      const lft = document.querySelector('.o5b');
      if (na2 && hd) { na2.after(hd); if (lft) hd.after(lft); }
    }
    // Blok 2 op volgorde zetten, en elk contact maar één keer tonen (ook niet als het al onder stap 1 staat).
    const gezien = new Set<string>();
    q('[data-eerste-contact] .gemeente-blok').filter((b) => !b.hidden).forEach((b) => b.querySelectorAll<HTMLAnchorElement>('a[href^="tel:"]').forEach((a) => gezien.add(a.getAttribute('href')!)));
    q('.routes-lijst').forEach((lijst) => {
      const rs = Array.from(lijst.querySelectorAll<HTMLElement>(':scope > [data-route]')).sort((x, y) => Number(x.style.order) - Number(y.style.order));
      const eerstAnders = lijst.querySelector(':scope > :not([data-route])');
      rs.forEach((r) => lijst.insertBefore(r, eerstAnders));
      if (lijst.hidden) return;
      // Het wijkteam eerst ontdubbelen: een contact dat ook bij het wijkteam hoort, blijft daar staan.
      [...rs].sort((x, y) => Number(y.dataset.route === 'wijkteam') - Number(x.dataset.route === 'wijkteam')).filter((r) => !r.hidden).forEach((r) => r.querySelectorAll<HTMLElement>('.contact').forEach((c) => {
        const sleutel = c.querySelector('a[href^="tel:"]')?.getAttribute('href') ?? c.querySelector('strong')?.textContent ?? '';
        c.hidden = !!sleutel && gezien.has(sleutel);
        if (sleutel) gezien.add(sleutel);
      }));
    });
  };
  document.addEventListener('jr:situaties', (e) => { sel = (e as CustomEvent).detail; render(); });
  // Pas tekenen als de blokken van de gemeente er zijn; is er intussen een andere gekozen, dan tekent die.
  document.addEventListener('jr:gemeente', (e) => { gem = (e as CustomEvent).detail; laadGemeente(gem).then((ok) => ok && render()); });
  document.addEventListener('jr:knelpunt', (e) => { kp = (e as CustomEvent).detail; render(); });
  document.addEventListener('jr:leeftijd', (e) => { lf = (e as CustomEvent).detail; render(); });
  laadGemeente(gem).then(() => {
    render();
    document.documentElement.classList.remove('jr-laden');
  });
</script>
