---
import Base from '../../layouts/Base.astro';
import { gesorteerd } from '../../lib/collecties';
import HulpsoortKaart from '../../components/HulpsoortKaart.astro';
import ToegangLegenda from '../../components/ToegangLegenda.astro';
import { afbreken } from '../../lib/afbreken';
import { base } from '../../site';
import { SITUATIE_GROEPEN } from '../../lib/situatie-groepen';
const situaties = await gesorteerd('situaties');
const hulpsoorten = await gesorteerd('hulpsoorten');
/** Per groep (vaste volgorde) de situaties op alfabet. */
const opNaam = new Intl.Collator('nl', { sensitivity: 'base' });
const groepen = SITUATIE_GROEPEN.map((g) => ({
  ...g,
  situaties: situaties.filter((s) => s.data.groep === g.id).sort((a, b) => opNaam.compare(a.data.titel, b.data.titel)),
}));
---

<Base
  title="Situaties en hulpsoorten"
  description="Herkent u de situatie van uw kind? Lees per situatie welke hulp er is, waar u begint en wat u zelf kunt doen."
>
  <div class="page-head">
    <span class="eyebrow">Wat speelt er?</span>
    <h1>Situaties</h1>
    <p class="lead">
      Kies wat het meest lijkt op uw situatie. U ziet dan welke hulp er bestaat, welke route logisch is en welke regelingen en organisaties erbij horen.
      Meerdere situaties tegelijk komt vaak voor; kijk gerust bij allebei.
    </p>
  </div>
  {groepen.map((g) => (
    <section class="situatie-groep" aria-labelledby={`groep-${g.id}`}>
      <h2 id={`groep-${g.id}`}>{g.titel}</h2>
      <div class="grid">
        {g.situaties.map((s) => (
          <a class="card link" href={`${base}/situaties/${s.id}/`}>
            <h3>{afbreken(s.data.titel)}</h3>
            <p class="meta">{s.data.herkenning}</p>
            <span class="arrow">Bekijk →</span>
          </a>
        ))}
      </div>
    </section>
  ))}

  <div class="kicker">
    <h2 id="hulpsoorten">Welke soorten jeugdhulp bestaan er?</h2>
    <span class="line"></span>
  </div>
  <p class="lead" style="font-size:1.05rem;margin-top:.75rem">
    Dit zijn de soorten hulp die elke gemeente moet kunnen bieden. De namen van aanbieders verschillen, de soorten niet.
  </p>
  <ToegangLegenda />
  <div class="grid" style="margin-top:1.25rem">
    {hulpsoorten.map((h) => (
      <HulpsoortKaart h={h} voorWie id={h.id} style="scroll-margin-top:5.5rem" />
    ))}
  </div>
</Base>
