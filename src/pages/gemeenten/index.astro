---
import Base from '../../layouts/Base.astro';
import GemeenteCard from '../../components/GemeenteCard.astro';
import GemeenteZoeker from '../../components/GemeenteZoeker.astro';
import { getCollection } from 'astro:content';
const gemeenten = (await getCollection('gemeenten')).sort((a, b) => a.data.naam.localeCompare(b.data.naam));
---
<Base title="Gemeenten" description="Zoek uw gemeente en zie waar u terechtkunt voor jeugdhulp, wie u kunt bellen en hoe het daar gaat.">
  <div class="page-head">
    <span class="eyebrow">Overzicht</span>
    <h1>Gemeenten</h1>
    <p class="lead">Alle {gemeenten.length} Nederlandse gemeenten staan op deze site. Elke gemeentepagina volgt dezelfde indeling: toegang, rechten, aanbod en lokale steun.</p>
    <div style="max-width:34rem;margin-top:1.25rem"><GemeenteZoeker target="#gemeenten-grid" /></div>
  </div>
  <div class="grid" id="gemeenten-grid">
    {gemeenten.map((g) => <GemeenteCard g={g} showStatus />)}
  </div>
  <p class="empty empty-result" hidden style="margin-top:1rem">Geen gemeente gevonden.</p>
</Base>
