---
import Base from '../../layouts/Base.astro';
import AfdrukKnop from '../../components/AfdrukKnop.astro';
import AfdrukKop from '../../components/AfdrukKop.astro';
import Sources from '../../components/Sources.astro';
import TherapieToelichting from '../../components/TherapieToelichting.astro';
import { getCollection } from 'astro:content';
import { afbreken } from '../../lib/afbreken';
export async function getStaticPaths() {
  const alle = await getCollection('therapievormen');
  return alle.map((t) => ({ params: { slug: t.id }, props: { t } }));
}
const { t } = Astro.props;
const d = t.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const situaties = (await getCollection('situaties')).filter((s) => d.situaties.includes(s.id)).sort((a, b) => a.data.volgorde - b.data.volgorde);
const brieven = (await getCollection('brieven')).filter((b) => b.id === 'aanvraag-jeugdhulp');
const hulpsoorten = (await getCollection('hulpsoorten')).filter((x) => d.hulpsoorten.includes(x.id));
if (hulpsoorten.length !== d.hulpsoorten.length) throw new Error(`Onbekende hulpsoort bij therapievorm "${t.id}": ${d.hulpsoorten.join(', ')}`);
// Toelichting mag een verwijzing naar een andere pagina bevatten als [tekst](/pad/).
const metLinks = (tekst: string) => tekst.split(/(\[[^\]]+\]\([^)]+\))/).map((deel) => { const m = deel.match(/^\[([^\]]+)\]\(([^)]+)\)$/); return m ? { tekst: m[1], href: m[2].startsWith('/') ? `${base}${m[2]}` : m[2] } : { tekst: deel }; });
const ob: Record<string, string> = { richtlijn: 'Aanbevolen in een zorgstandaard of jeugdhulprichtlijn', erkend: 'Erkend in de NJi-databank effectieve jeugdinterventies', onderbouwd: 'Goed onderbouwd volgens de NJi-databank, effect nog niet onderzocht', gangbaar: 'Gangbaar, maar beperkter wetenschappelijk onderzocht' };
---
<Base title={d.naam} description={d.kort}>
  <div class="page-head">
    <p class="meta terug" style="margin-bottom:.5rem"><a href={`${base}/situaties/`} data-terug data-anchor="#therapie" data-anchor-overzicht="#tips" data-situaties={situaties.map((s) => `${s.id}|${s.data.titel}`).join(';')}>← Terug naar situaties</a></p>
    <span class="eyebrow">Therapievorm · {ob[d.onderbouwing.label]}</span>
    <h1>{afbreken(d.naam)}</h1>
    <AfdrukKop />
    <p class="lead">{d.kort}</p>
  </div>
  <div class="page-with-side">
    <aside class="side">
      <nav aria-label="Inhoud">
        <strong>Op deze pagina</strong>
        <a href="#wat"><span class="n">1</span>Wat is het</a>
        <a href="#aanvragen"><span class="n">2</span>Zo vraagt u het aan</a>
        <a href="#voorwie"><span class="n">3</span>Voor wie</a>
        <a href="#verwachting"><span class="n">4</span>Wat kunt u verwachten</a>
        <a href="#onderbouwing"><span class="n">5</span>Onderbouwing en vergoeding</a>
      </nav>
    </aside>
    <div>
      <AfdrukKnop />
      <TherapieToelichting />
      <section class="section" id="wat"><h2><span class="section-num">1</span>Wat is het en hoe werkt het?</h2><p>{d.watIsHet}</p><p>{d.hoeWerktHet}</p>
        {d.sessie && <><h3>Zo gaat een sessie</h3><p>{d.sessie}</p></>}
        {d.programmas.length > 0 && <><h3>Vormen</h3><ul>{d.programmas.map((p) => <li><strong>{p.url ? <a href={p.url} target="_blank" rel="noopener">{p.naam}<span aria-hidden="true"> ↗</span></a> : p.naam}</strong> – {p.omschrijving}</li>)}</ul></>}</section>
      <section class="section regelen" id="aanvragen"><h2><span class="section-num">2</span>Zo vraagt u het aan</h2>
        {(hulpsoorten.length > 0 || d.zorgverzekering) && <p class="meta"><strong>Valt onder:</strong> {hulpsoorten.map((x, i) => <>{i > 0 && ' en '}{x.data.inDePraktijk ? <a href={`${base}/hulpsoorten/${x.id}/`}>{x.data.naam.toLowerCase()}</a> : <a href={`${base}/situaties/#${x.id}`}>{x.data.naam.toLowerCase()}</a>}</>)}{hulpsoorten.length > 0 && d.zorgverzekering && '; '}{d.zorgverzekering && (hulpsoorten.length > 0 ? 'deels via de zorgverzekering' : 'de zorgverzekering, niet de gemeente')}.</p>}
        <p>{d.aanvragen}</p>
        {d.vragen.length > 0 && <><h3>Vragen voor de behandelaar</h3><ul>{d.vragen.map((v) => <li>{v}</li>)}</ul></>}
        {/\bverwijzer\b/i.test(d.aanvragen) && <p class="meta"><strong>Wie is de verwijzer?</strong> De huisarts, de jeugdarts of een medisch specialist. Ook het wijkteam van uw gemeente kan u verder helpen.</p>}
        <p class="meta">Beschrijf in uw hulpvraag wat u ziet, wat u wilt bereiken en waarom deze vorm daarbij past. Zo kunnen u en het team samen de afweging maken; het team kent het lokale aanbod en kan een andere vorm voorstellen als die beter past. {brieven.length > 0 && <a href={`${base}/brieven/aanvraag-jeugdhulp/`}>Voorbeeldbrief hulpvraag →</a>}</p>
      </section>
      <section class="section" id="voorwie"><h2><span class="section-num">3</span>Voor wie past het?</h2><p>{d.voorWie}</p>{d.leeftijd && <p class="meta">Leeftijd: ongeveer {d.leeftijd.van ?? 0}{d.leeftijd.tot ? ` tot ${d.leeftijd.tot}` : ' jaar en ouder'}{d.leeftijd.tot ? ' jaar' : ''}.</p>}
        {d.overwegingen.length > 0 && <ul>{d.overwegingen.map((o) => <li>{o}</li>)}</ul>}</section>
      <section class="section" id="verwachting"><h2><span class="section-num">4</span>Wat kunt u verwachten?</h2><p>{d.verwachting}</p>
        {d.vraagt && <><h3>Wat het van uw kind en van u vraagt</h3><p>{d.vraagt}</p></>}
        {d.voortgang && <><h3>Wanneer merkt u verschil?</h3><p>{d.voortgang}</p></>}</section>
      <section class="section" id="onderbouwing"><h2><span class="section-num">5</span>Onderbouwing en vergoeding</h2>
        <p><strong>{ob[d.onderbouwing.label]}.</strong> {metLinks(d.onderbouwing.toelichting).map((x) => (x.href ? <a href={x.href}>{x.tekst}</a> : x.tekst))}</p>
        {d.effect && <><h3>Wat onderzoek laat zien</h3><p>{d.effect}</p></>}
        <p><strong>Vergoeding:</strong> {d.vergoeding}</p></section>
      <Sources bronnen={d.bronnen} laatstGecontroleerd={d.meta.laatstGecontroleerd} />
    </div>
  </div>
</Base>
<script>
  import { zetTerugLink } from '../../lib/terug';
  zetTerugLink();
</script>
