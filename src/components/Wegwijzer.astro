---
/** Wegwijzer op de hoofdpagina: gemeente + situaties → overzichtspagina. */
import GemeenteKeuze from './GemeenteKeuze.astro';
import SituatieKeuze from './SituatieKeuze.astro';
import KnelpuntKeuze from './KnelpuntKeuze.astro';
import LeeftijdKeuze from './LeeftijdKeuze.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div class="wegwijzer">
  <GemeenteKeuze />
  <p class="meta wegwijzer-hint">Kies hieronder ook waar uw vraag over gaat of wat er speelt bij uw kind. Dan krijgt u een overzicht dat bij u past.</p>
  <KnelpuntKeuze />
  <LeeftijdKeuze />
  <SituatieKeuze mode="link" />
</div>
<!-- Na een keuze blijft de weg naar het overzicht in beeld, ook als de knop zelf buiten beeld is. -->
<div class="cta-balk" data-cta-balk hidden>
  <span class="cta-tekst" data-cta-tekst></span>
  <a class="btn primary" href={`${base}/overzicht/`} data-overzicht>Toon mijn overzicht →</a>
  <button type="button" class="btn primary" data-kies-gemeente hidden>Kies eerst uw gemeente ↑</button>
</div>
<script>
  const balk = document.querySelector<HTMLElement>('[data-cta-balk]');
  const tekst = document.querySelector<HTMLElement>('[data-cta-tekst]');
  const knop = document.querySelector<HTMLElement>('.situatie-keuze a[data-overzicht]');
  const balkKnop = balk?.querySelector<HTMLElement>('a[data-overzicht]');
  const kiesGemeente = balk?.querySelector<HTMLButtonElement>('[data-kies-gemeente]');
  const sel = document.querySelector<HTMLSelectElement>('.wegwijzer [data-gemeente-keuze]');
  let gekozen = false;
  let mistGemeente = false;
  let knopInBeeld = true;
  // Zonder gemeente blijft de balk staan (ook als de knop zelf in beeld is), met de vraag om eerst een gemeente te kiezen.
  const toon = () => { if (balk) balk.hidden = !gekozen || (knopInBeeld && !mistGemeente); };
  // De gemeente is verplicht, behalve bij spoed en bij landelijke vragen (zoals kinderbijslag of zorgen om een kind van een ander).
  const gemeenteNodig = () => {
    const kp = document.querySelector<HTMLElement>('.wegwijzer .chip-btn[aria-pressed="true"][data-knelpunt]');
    return !(kp && kp.dataset.gemeenteOptioneel === 'true');
  };
  const naarGemeente = () => { if (!sel) return; sel.scrollIntoView({ block: 'center', behavior: 'smooth' }); sel.focus({ preventScroll: true }); (sel as any).showPicker?.(); };
  kiesGemeente?.addEventListener('click', naarGemeente);
  // Ook de knop "Toon mijn overzicht" onder de keuzes: zonder gemeente eerst naar de gemeentekeuze.
  document.querySelectorAll<HTMLAnchorElement>('.wegwijzer a[data-overzicht], .cta-balk a[data-overzicht]').forEach((a) => a.addEventListener('click', (e) => {
    if (mistGemeente) { e.preventDefault(); naarGemeente(); }
  }));
  const update = () => {
    const gem = sel && sel.value && sel.value !== '_overig' ? sel.options[sel.selectedIndex].text : '';
    const knoppen = Array.from(document.querySelectorAll<HTMLButtonElement>('.wegwijzer .chip-btn[aria-pressed="true"]')).map((b) => b.textContent?.trim());
    const delen = [gem, ...knoppen].filter(Boolean);
    // Pas na een vraag of situatie: alleen een gemeente geeft een algemeen overzicht, en dan slaan ouders de vragen hieronder over.
    gekozen = document.querySelectorAll('.wegwijzer .chip-btn[aria-pressed="true"][data-knelpunt], .wegwijzer .chip-btn[aria-pressed="true"][data-situatie]').length > 0;
    mistGemeente = gekozen && !(sel && sel.value) && gemeenteNodig();
    if (balkKnop) balkKnop.hidden = mistGemeente;
    if (kiesGemeente) kiesGemeente.hidden = !mistGemeente;
    if (tekst) tekst.textContent = mistGemeente ? 'Kies eerst uw gemeente. Dan ziet u wie u daar kunt bellen.' : (delen.length ? `Gekozen: ${delen.join(' · ')}` : '');
    toon();
  };
  // Na een vraagknop de rij "Wat speelt er bij uw kind?" in beeld brengen: die rij werd vaak gemist.
  const sitRij = document.querySelector<HTMLElement>('.wegwijzer .situatie-keuze');
  document.querySelectorAll<HTMLButtonElement>('.wegwijzer [data-knelpunt]').forEach((b) => b.addEventListener('click', () => setTimeout(() => {
    if (!sitRij || b.getAttribute('aria-pressed') !== 'true' || b.dataset.gemeenteOptioneel === 'true') return;
    if (sitRij.querySelector('[data-situatie][aria-pressed="true"]')) return;
    // Zonder gemeente vraagt de balk eerst om de gemeente; dan niet wegscrollen van de gemeentekeuze.
    if (mistGemeente) return;
    const r = sitRij.getBoundingClientRect();
    if (r.top > window.innerHeight * 0.6) sitRij.scrollIntoView({ block: 'start', behavior: 'smooth' });
  })));
  for (const ev of ['jr:situaties', 'jr:gemeente', 'jr:knelpunt', 'jr:leeftijd']) document.addEventListener(ev, () => setTimeout(update));
  // Een vraag of situatie gekozen zonder gemeente: meteen naar de gemeentekeuze (persona-tests: de knop leek niets te doen).
  // Na update() (die loopt via setTimeout na het event), en zonder de keuzelijst zelf open te klappen. Eén keer per bezoek,
  // zodat wie eerst meerdere keuzes maakt niet steeds terugspringt.
  let gemeenteGewezen = false;
  document.querySelectorAll<HTMLButtonElement>('.wegwijzer [data-knelpunt], .wegwijzer [data-situatie]').forEach((b) => b.addEventListener('click', () => setTimeout(() => {
    if (gemeenteGewezen || !mistGemeente || b.getAttribute('aria-pressed') !== 'true' || !sel) return;
    gemeenteGewezen = true;
    sel.scrollIntoView({ block: 'center', behavior: 'smooth' });
    sel.focus({ preventScroll: true });
    sel.classList.add('aandacht');
    setTimeout(() => sel.classList.remove('aandacht'), 2500);
  }, 30)));
  if (knop) new IntersectionObserver(([e]) => { knopInBeeld = e.isIntersecting; toon(); }).observe(knop);
  update();
</script>
