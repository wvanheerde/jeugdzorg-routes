---
/**
 * Tweede as: waar gaat de vraag van de ouder over (aanvragen, wachten, geld, 18 worden …)?
 * Enkele keuze. Bewaard als "jr.knelpunt" en ?k= in de URL. Event "jr:knelpunt".
 */
import { getCollection } from 'astro:content';
interface Props { label?: string }
const { label = 'Waar gaat uw vraag over?' } = Astro.props;
const knelpunten = (await getCollection('knelpunten')).sort((a, b) => a.data.volgorde - b.data.volgorde);
---
<div class="field knelpunt-keuze">
  <span>{label}</span>
  <div class="chips-select" role="group" aria-label="Waar gaat uw vraag over">
    {knelpunten.map((k) => <button type="button" class="chip-btn" data-knelpunt={k.id} data-gemeente-optioneel={k.data.zonderGemeente || k.id === 'spoed' ? 'true' : undefined} aria-pressed="false" title={k.data.herkenning}>{k.data.titel}</button>)}
  </div>
</div>
<script>
  const KEY = 'jr.knelpunt';
  const fromUrl = new URLSearchParams(location.search).get('k');
  if (fromUrl !== null) localStorage.setItem(KEY, fromUrl);
  let current = localStorage.getItem(KEY) ?? '';
  const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip-btn[data-knelpunt]'));
  const updateLink = () => document.querySelectorAll<HTMLAnchorElement>('a[data-overzicht]').forEach((a) => { const u = new URL(a.href); current ? u.searchParams.set('k', current) : u.searchParams.delete('k'); a.href = u.toString(); });
  const sync = () => {
    localStorage.setItem(KEY, current);
    btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.knelpunt === current)));
    updateLink();
    document.dispatchEvent(new CustomEvent('jr:knelpunt', { detail: current }));
  };
  btns.forEach((b) => b.addEventListener('click', () => { current = current === b.dataset.knelpunt ? '' : b.dataset.knelpunt!; sync(); }));
  // Andere keuzes herschrijven de link; de eigen parameter moet daarna opnieuw gezet worden.
  for (const ev of ['jr:situaties', 'jr:gemeente', 'jr:knelpunt', 'jr:leeftijd']) if (ev !== 'jr:knelpunt') document.addEventListener(ev, updateLink);
  sync();
</script>
