---
/**
 * Compacte meerkeuze van situaties. Keuze wordt bewaard in localStorage ("jr.situaties")
 * en als ?s=a,b in de URL. Verstuurt event "jr:situaties" met een array van id's.
 * mode="link": knop "Toon mijn overzicht" gaat naar /overzicht/. mode="inline": werkt op de huidige pagina.
 */
import { getCollection } from 'astro:content';
interface Props { mode?: 'link' | 'inline'; label?: string }
const { mode = 'link', label = 'Wat speelt er bij uw kind? (meerdere mogelijk)' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const situaties = (await getCollection('situaties')).sort((a, b) => a.data.volgorde - b.data.volgorde);
---
<div class="field situatie-keuze" data-mode={mode} data-base={base}>
  <span>{label}</span>
  <div class="chips-select" role="group" aria-label="Situaties">
    {situaties.map((s) => (
      <button type="button" class="chip-btn" data-situatie={s.id} aria-pressed="false" title={s.data.herkenning}>{s.data.titel}</button>
    ))}
  </div>
  {mode === 'link' && (
    <div class="actions" style="margin-top:.5rem">
      <a class="btn primary" href={`${base}/overzicht/`} data-overzicht>Toon mijn overzicht</a>
      <button type="button" class="keuzes-wissen" data-keuzes-wissen hidden>Keuzes wissen</button>
    </div>
  )}
</div>
<script>
  const KEY = 'jr.situaties';
  const fromUrl = new URLSearchParams(location.search).get('s');
  if (fromUrl !== null) localStorage.setItem(KEY, fromUrl);
  const selected = new Set((localStorage.getItem(KEY) ?? '').split(',').filter(Boolean));
  // updateLink: alleen de link bijwerken (ook bij wijzigingen van andere keuzes). sync: eigen keuze opslaan en event sturen.
  const updateLink = () => {
    document.querySelectorAll<HTMLAnchorElement>('a[data-overzicht]').forEach((a) => {
      const u = new URL(a.href);
      u.searchParams.set('s', Array.from(selected).join(','));
      const g = localStorage.getItem('jr.gemeente');
      if (g && g !== '_overig') u.searchParams.set('gemeente', g); else u.searchParams.delete('gemeente');
      a.href = u.toString();
    });
  };
  const sync = () => {
    localStorage.setItem(KEY, Array.from(selected).join(','));
    document.querySelectorAll<HTMLButtonElement>('.chip-btn[data-situatie]').forEach((b) => b.setAttribute('aria-pressed', String(selected.has(b.dataset.situatie!))));
    updateLink();
    document.dispatchEvent(new CustomEvent('jr:situaties', { detail: Array.from(selected) }));
  };
  document.querySelectorAll<HTMLButtonElement>('.chip-btn[data-situatie]').forEach((b) => {
    b.addEventListener('click', () => { const id = b.dataset.situatie!; selected.has(id) ? selected.delete(id) : selected.add(id); sync(); });
  });
  document.addEventListener('jr:gemeente', updateLink);
  sync();

  // "Keuzes wissen": alleen zichtbaar als er iets gekozen is. Wist gemeente, vraag, leeftijd en situaties en laadt de pagina schoon.
  const KEYS = ['jr.gemeente', 'jr.knelpunt', 'jr.leeftijd', 'jr.situaties'];
  const wissen = document.querySelector<HTMLButtonElement>('[data-keuzes-wissen]');
  const toonWissen = () => { if (wissen) wissen.hidden = !KEYS.some((k) => localStorage.getItem(k)); };
  for (const ev of ['jr:gemeente', 'jr:knelpunt', 'jr:leeftijd', 'jr:situaties']) document.addEventListener(ev, () => setTimeout(toonWissen));
  toonWissen();
  wissen?.addEventListener('click', () => {
    KEYS.forEach((k) => localStorage.removeItem(k));
    location.replace(location.pathname);
  });
</script>
