---
/**
 * Datumveld dd-mm-jjjj met kalenderknop (gedrag: src/lib/datumveld.ts), voor de verdiepingen in Mijn overzicht en de rekenhulp
 * (TermijnenHulp.astro).
 * minJaren / maxJaren / startJaren: grenzen en beginpunt van de kalender, in jaren vanaf vandaag (zie datumveld.ts). Zonder: geen grenzen.
 * Waaraan het script het tekstveld vindt: veld = naam van een eigen data-attribuut (veld="vh-datum" → data-vh-datum, Mijn overzicht),
 * of invoer = waarde van data-th-invoer (invoer="besluit" → data-th-invoer="besluit", de rekenhulp).
 */
interface Props {
  id: string;
  minJaren?: number;
  maxJaren?: number;
  startJaren?: number;
  veld?: string;
  invoer?: string;
}
const { id, minJaren, maxJaren, startJaren, veld, invoer = '' } = Astro.props;
---
<span class="th-veld" data-min-jaren={minJaren} data-max-jaren={maxJaren} data-start-jaren={startJaren}><input type="text" inputmode="numeric" placeholder="dd-mm-jjjj" maxlength="10" autocomplete="off" id={id} data-th-invoer={invoer} {...(veld ? { [`data-${veld}`]: '' } : {})} /><button type="button" class="th-kalender" data-th-kalender aria-label="Kies een datum in de kalender"><span class="ico ico-calendar" aria-hidden="true"></span></button><input type="date" class="th-datum" data-th-datum tabindex="-1" aria-hidden="true" /></span>
