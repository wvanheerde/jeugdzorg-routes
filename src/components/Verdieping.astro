---
/**
 * Verdieping in "Wat kunt u doen" (Mijn overzicht): een paar vragen die de stappen eronder passend maken. Altijd optioneel.
 * Het blok zelf doet niets met de antwoorden; dat doet de pagina (zie de verhuizing in overzicht.astro). De pagina zet
 * de samenvatting in [data-vd-samenvatting] en roept bij een bewaard antwoord inklappen aan via data-vd-ingeklapt.
 * Ingeklapt staat alleen de samenvatting met "Aanpassen"; zo staat bij een tweede bezoek het antwoord voorop.
 * Geen uitleg bij moeilijke woorden in de samenvatting (data-geen-uitleg): de pagina schrijft die bij elk antwoord opnieuw, en de uitleg hoort bij de stappen.
 */
/** naarStappen: id van het begin van de stappen (overzicht.astro: stappen-<vraag>). Elke verdieping heeft hem, voor een gelijk gedrag. Dan staat na een antwoord links van "Wissen" een link "De stappen zijn aangepast ↓" (de pagina
 *  toont hem via data-vd-gevolg), want de stappen veranderen buiten beeld (persona-test Peter r6). */
interface Props { id: string; titel?: string; uitleg?: string; naarStappen?: string }
const { id, titel = 'Meer passend advies', uitleg, naarStappen } = Astro.props;
---
<section class="verdieping o1" data-verdieping={id} aria-labelledby={`vd-kop-${id}`}>
  <div data-vd-vragen>
    <h3 id={`vd-kop-${id}`}>{titel} <span class="vd-optioneel">niet verplicht</span></h3>
    {uitleg && <p class="meta vd-uitleg">{uitleg}</p>}
    <div class="vd-velden"><slot /></div>
  </div>
  <p class="vd-samenvatting" aria-live="polite"><span data-vd-samenvatting data-geen-uitleg></span><span class="vd-acties">{naarStappen && <a class="vd-gevolg" href={`#${naarStappen}`} data-vd-gevolg hidden>De stappen zijn aangepast&nbsp;↓</a>}<button type="button" class="linkknop" data-vd-aanpassen hidden>Aanpassen</button><button type="button" class="linkknop" data-vd-wissen hidden>Wissen</button></span></p>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-verdieping]').forEach((blok) => {
    const vragen = blok.querySelector<HTMLElement>('[data-vd-vragen]')!;
    const aanpassen = blok.querySelector<HTMLButtonElement>('[data-vd-aanpassen]')!;
    // De pagina zet data-vd-ingeklapt; hier alleen tonen wat daarbij hoort.
    const toon = () => {
      const dicht = blok.hasAttribute('data-vd-ingeklapt');
      vragen.hidden = dicht;
      aanpassen.hidden = !dicht;
    };
    new MutationObserver(toon).observe(blok, { attributes: true, attributeFilter: ['data-vd-ingeklapt'] });
    aanpassen.addEventListener('click', () => {
      blok.removeAttribute('data-vd-ingeklapt');
      blok.querySelector<HTMLElement>('input, select, [data-vd-vragen] button')?.focus();
    });
    toon();
  });
</script>
