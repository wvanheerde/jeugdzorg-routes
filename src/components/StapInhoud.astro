---
/**
 * De inhoud van één stap in Mijn overzicht (ook een vervolgstap A, B): vet begin, de brief, het contactregeltje van genoemde
 * organisaties, de plekken voor gemeentegegevens (cliëntondersteuner, aanbieders) en de tips-link.
 * De keuze wat bij een stap hoort, staat in src/lib/stap-props.ts.
 */
import OrgRegel from './OrgRegel.astro';
import { getCollection } from 'astro:content';
interface Props {
  tekst: string;
  orgs?: { data: { naam: string; telefoon?: string; url: string } }[];
  /** zoek: een vraag achter de link, zoals ?klacht=wachten (dan staat die klacht in de brief al aan). */
  brief?: { id: string; label: string; zoek?: string };
  co?: boolean;
  aanbieders?: boolean;
  wijkteam?: boolean;
  stand?: 'doorlooptijd' | 'ervaringen';
  tips?: boolean;
  /** Link naar het vel om het gesprek voor te bereiden (/gesprek/), bij "Zet uw vraag op papier". */
  gesprek?: boolean;
  /** Verhuizing: plek in de tijdlijn (de kop komt uit de verdieping, zie src/scripts/overzicht/verhuizing.ts) en of hier de nieuwe gemeente komt. */
  moment?: 'nu' | 'voor' | 'na' | 'pleeg';
  nieuw?: boolean;
  /** "De hulp stopt": bij welke reden de stap hoort (verdieping "Waarom stopt de hulp?", zie src/lib/verdiepingen.ts). */
  reden?: string;
  /** "Mijn kind wordt 18": het begin van de stap (woorden) wordt in de verdieping een datum; soort = bij welke hulp na 18 de stap hoort. */
  wanneer?: { woorden: string; moment: string; soort?: string; weken?: number };
  /** "Wij wachten te lang": bij welke route de stap hoort (op), en wat een datum uit de verdieping vervangt: een zin in de tekst (zin)
   *  of het begin (lead: de stap over de ingebrekestelling of die over daarna). Bij een lead staat de rest apart, zodat die weg kan als de stap gedaan is. */
  wacht?: { op?: string; zin?: string; lead?: 'ingebrekestelling' | 'daarna' };
  /** "Hulp is afgewezen of te weinig": de rol van de stap (om het besluit op papier vragen, of het pgb) en de zin over de zes weken,
   *  die de verdieping vervangt door de laatste dag voor bezwaar (zie src/scripts/overzicht/afgewezen.ts). */
  afgewezen?: { rol?: 'papier' | 'pgb'; zin?: string };
  /** "Wij zijn uit elkaar": bij welk gezag de stap hoort, en de zin over toestemming bij KIES (zie src/scripts/overzicht/gescheiden.ts). */
  gescheiden?: { gezag?: string; zin?: string };
  /** "Ik wil hulp uitbreiden": de stap over het aflopen van het besluit, en de zin die de einddatum vervangt (zie src/scripts/overzicht/uitbreiden.ts).
   *  Wat na die zin staat, staat apart (data-zin-na), zodat het weg kan als de einddatum voorbij is. */
  uitbreiden?: { rol?: string; zin?: string };
}
const { tekst, orgs = [], brief, co = false, aanbieders = false, wijkteam = false, stand, tips = false, gesprek = false, moment, nieuw = false, reden, wanneer, wacht, afgewezen, gescheiden, uitbreiden } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Begint een stap met een vraag of een moment ("Wacht u op een besluit?", "Rond de verjaardag:"), dan staat dat begin vet,
// zodat een scannende ouder ziet welke stap voor hem geldt (persona-tests ronde 21).
const m = tekst.match(/^([^.?!:]{2,110}[?:])\s+([\s\S]+)$/);
// "Mijn kind wordt 18" (wanneer): de hele eerste zin is het begin, want die zegt wanneer, wat en bij wie.
const m1 = wanneer ? tekst.match(/^(.+?[.?!])\s+([\s\S]+)$/) : null;
const [lead, rest] = m1 ? [m1[1], m1[2]] : m ? [m[1], m[2]] : [null, tekst];
// Het moment ("Ruim vóór de verjaardag") apart, zodat de verdieping er een datum van kan maken; de rest van het begin blijft staan.
const momentWoorden = wanneer && lead?.startsWith(wanneer.woorden) ? wanneer.woorden : null;
// Noemt de stap een andere vraag tussen aanhalingstekens ("Lees daarover bij "Ik wil hulp uitbreiden""), dan is dat een link naar die vraag.
const vragen = new Map((await getCollection('knelpunten')).map((k) => [k.data.titel, k.id]));
const links = (t: string) => t.split(/"([^"]+)"/).map((t, i) => (i % 2 === 1 && vragen.has(t) ? { titel: t, id: vragen.get(t)! } : i % 2 === 1 ? `"${t}"` : t));
// Een zin die de verdieping kan vervangen (wacht.zin, afgewezen.zin, gescheiden.zin, uitbreiden.zin) staat in een eigen span, met de oorspronkelijke tekst erbij om terug te zetten.
const zin = wacht?.zin ?? afgewezen?.zin ?? gescheiden?.zin ?? uitbreiden?.zin;
const [voor, na] = zin && rest.includes(zin) ? rest.split(zin) : [rest, null];
const delen = links(voor);
---
{reden && <span data-reden={reden} hidden></span>}{moment && <><strong class="stap-lead" data-moment={moment} hidden></strong> </>}{wanneer?.soort && <span data-soort={wanneer.soort} hidden></span>}{wacht?.op && <span data-wacht-op={wacht.op} hidden></span>}{afgewezen?.rol && <span data-af-rol={afgewezen.rol} hidden></span>}{gescheiden?.gezag && <span data-gezag={gescheiden.gezag} hidden></span>}{uitbreiden?.rol && <span data-ub-rol={uitbreiden.rol} hidden></span>}{lead && <><strong class="stap-lead" data-wacht-lead={wacht?.lead} data-origineel={wacht?.lead ? lead : undefined}>{momentWoorden ? <><span data-wanneer={wanneer!.moment} data-weken={wanneer!.weken} data-woorden={momentWoorden}>{momentWoorden}</span>{lead.slice(momentWoorden.length)}</> : lead}</strong> </>}<span data-wacht-rest={wacht?.lead}>{delen.map((d) => (typeof d === 'string' ? d : <a href={`${base}/overzicht/?k=${d.id}`}>"{d.titel}"</a>))}</span>{na !== null && <><span data-wacht-zin={wacht?.zin} data-bezwaar-zin={afgewezen?.zin} data-kies-zin={gescheiden?.zin} data-afloop-zin={uitbreiden?.zin}>{zin}</span><span data-zin-na>{links(na).map((d) => (typeof d === 'string' ? d : <a href={`${base}/overzicht/?k=${d.id}`}>"{d.titel}"</a>))}</span></>}{brief && <><a class="stap-brief" href={`${base}/brieven/${brief.id}/${brief.zoek ?? ''}`}>Voorbeeldbrief {brief.label} →</a></>}<OrgRegel orgs={orgs} />{stand && <div data-stand-stap data-gemeente-slot={`overzicht-stand-${stand}`}></div>}{wijkteam && <span data-wijkteam-stap data-gemeente-slot="overzicht-wijkteam-stap"></span>}{co && <span data-co-stap data-gemeente-slot="overzicht-co-stap"></span>}{aanbieders && <span data-aanbieders-stap data-gemeente-slot="overzicht-aanbieders-stap"></span>}{nieuw && <span class="stap-nieuw" data-nieuw-stap hidden><span data-nieuwe-gemeente-slot="overzicht-wijkteam-stap"></span><span data-nieuwe-gemeente-slot="overzicht-aanbieders-stap"></span></span>}{gesprek && <a class="stap-tips" href={`${base}/gesprek/`}>Bereid het gesprek voor: een vel om af te drukken en in te vullen →</a>}{tips && <a class="stap-tips" href={`${base}/landelijk/#02b-hulp-vragen`}>Tips om uw vraag eerlijk en volledig te vertellen →</a>}
