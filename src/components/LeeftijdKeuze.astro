---
/**
 * Optionele leeftijdsband. Enkele keuze. Bewaard als "jr.leeftijd" en ?l= in de URL. Event "jr:leeftijd".
 * Banden: 0-4, 4-12, 12-18, 18+ (bovengrens exclusief). Bij het kiezen van "Mijn kind wordt 18" gaat 12-18 vanzelf aan.
 */
interface Props { label?: string }
const { label = 'Hoe oud is uw kind? (optioneel)' } = Astro.props;
export const BANDEN = [
  { id: '0-4', titel: 'Jonger dan 4', van: 0, tot: 4 },
  { id: '4-12', titel: '4 tot 12', van: 4, tot: 12 },
  { id: '12-18', titel: '12 tot 18', van: 12, tot: 18 },
  { id: '18-99', titel: '18 of ouder', van: 18, tot: 99 },
];
---
<div class="field leeftijd-keuze">
  <span>{label}</span>
  <div class="chips-select" role="group" aria-label="Leeftijd van uw kind">
    {BANDEN.map((b) => <button type="button" class="chip-btn" data-leeftijd={b.id} aria-pressed="false">{b.titel}</button>)}
  </div>
</div>
<script>
  const KEY = 'jr.leeftijd';
  const fromUrl = new URLSearchParams(location.search).get('l');
  if (fromUrl !== null) localStorage.setItem(KEY, fromUrl);
  let current = localStorage.getItem(KEY) ?? '';
  const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip-btn[data-leeftijd]'));
  const updateLink = () => document.querySelectorAll<HTMLAnchorElement>('a[data-overzicht]').forEach((a) => { const u = new URL(a.href); current ? u.searchParams.set('l', current) : u.searchParams.delete('l'); a.href = u.toString(); });
  const sync = () => {
    localStorage.setItem(KEY, current);
    btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.leeftijd === current)));
    updateLink();
    document.dispatchEvent(new CustomEvent('jr:leeftijd', { detail: current }));
  };
  btns.forEach((b) => b.addEventListener('click', () => { current = current === b.dataset.leeftijd ? '' : b.dataset.leeftijd!; sync(); }));
  // Kiest de ouder "Mijn kind wordt 18" en staat er nog geen leeftijd, dan gaat "12 tot 18" aan: dan valt hulp voor jonge
  // kinderen (zoals vergoede dyslexiezorg tot 13) weg uit het overzicht, en de ouder ziet waarom. Alleen bij het kiezen zelf,
  // niet bij het laden van de pagina: wie de leeftijd daarna uitzet, houdt hem uit.
  let vorigeVraag = new URLSearchParams(location.search).get('k') ?? localStorage.getItem('jr.knelpunt') ?? '';
  document.addEventListener('jr:knelpunt', (e) => {
    const vraag = (e as CustomEvent).detail as string;
    if (vraag === 'wordt-18' && vorigeVraag !== 'wordt-18' && !current) { current = '12-18'; sync(); }
    vorigeVraag = vraag;
  });
  // Andere keuzes herschrijven de link; de eigen parameter moet daarna opnieuw gezet worden.
  for (const ev of ['jr:situaties', 'jr:gemeente', 'jr:knelpunt', 'jr:leeftijd']) if (ev !== 'jr:leeftijd') document.addEventListener(ev, updateLink);
  sync();
</script>
