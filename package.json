{
  "name": "jeugdzorg-routes",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/sitemap.mjs && pagefind --site dist --silent",
    "preview": "astro preview",
    "check": "astro check",
    "validate": "node scripts/validate-content.mjs",
    "links": "node scripts/check-links.mjs",
    "scaffold": "node scripts/scaffold-gemeenten.mjs",
    "test": "npm --prefix tests/e2e test",
    "dekking": "DEKKING=1 npm run build && npm --prefix tests/e2e run dekking"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "astro": "^7.3.8"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.5",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3"
  }
}
